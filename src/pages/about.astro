 ---
 import Header from  '../components/header.astro';
 import Footer from '../components/footer.astro';
 import { getEntry, render } from 'astro:content';

 const page = await getEntry('pages', 'about');
 if (!page) {
   throw new Error('Missing content/pages/about.md');
 }
 const { Content } = await render(page);
 ---
<Header title={page.data.title} />

<main id="main" tabindex="-1">
  <article class="article-page">
    <header class="card article-header">
      <h1>{page.data.title} <span class="cursor" aria-hidden="true"></span></h1>
    </header>

    <section class="card article-body">
      <Content />
    </section>
  </article>
</main>


<Footer></Footer>