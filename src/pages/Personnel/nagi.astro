---
import Header from  '../../components/header.astro';
import Footer from '../../components/footer.astro';
import { Image } from 'astro:assets';
import nagiProfile from "../../assets/images/nagi/profile.png";
import nagiGallery1 from "../../assets/images/nagi/1.png";
import nagiGallery2 from "../../assets/images/nagi/2.png";
import nagiGallery3 from "../../assets/images/nagi/3.png";
import nagiGallery4 from "../../assets/images/nagi/4.png";
---
<Header></Header>

<main>
  <div class="page-stack">
  <section class="card" role="article" aria-labelledby="nagi-heading">
    <h1 id="nagi-heading">Nagi <span class="cursor" aria-hidden="true"></span></h1>
    <div class="profile">
      <Image src={nagiProfile} class="pixelart-profile" quality={100} alt="A description of my image." />

      <dl class="info-dl">
        <div>
          <dt>Facility Position</dt>
          <dd>Containment Specialist</dd>
        </div>
        <div>
          <dt>Species</dt>
          <dd>Feline </dd>
        </div>
        <div>
          <dt>Gender</dt>
          <dd>Male</dd>
        </div>
        <div>
          <dt>Age</dt>
          <dd>25</dd>
        </div>
        <div>
          <dt>Birthplace</dt>
          <dd>Terra</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="card" role="region" aria-labelledby="bio-title">
    <h2 id="bio-title" class="db-title-cyan">Bio</h2>
    <p class="lead">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed molestie massa sed eros condimentum rhoncus. Nullam in justo ut tortor accumsan elementum a eu eros. In magna lectus, tristique a neque mattis, tempus tempor lectus. Nam interdum scelerisque turpis, eget varius elit iaculis sodales. Duis elit metus, faucibus et mollis eget, vehicula ut massa. Nullam laoreet pretium dictum. Duis commodo tincidunt dapibus. Suspendisse potenti. </p>
    <p>Aliquam rhoncus porttitor ligula quis imperdiet. Etiam sed orci ligula. Aliquam laoreet ultricies augue sed mollis. Integer sed nunc maximus, hendrerit lacus at, elementum tellus. Integer vel ligula nec sem condimentum tempor. Morbi eget ipsum vitae quam convallis vestibulum. Maecenas vel mauris quam. Proin pellentesque, nunc porttitor suscipit finibus, turpis nibh laoreet augue, dapibus commodo risus nisi feugiat velit. </p>
  </section>

  <section class="traits-grid" aria-label="Traits">
    <div class="card" role="region" aria-labelledby="pos-title">
      <h2 id="pos-title" class="db-title-yellow">Positive Traits</h2>
      <ul class="trait-list positive">
        <li>Test</li>
        <li>Test</li>
        <li>Test</li>
        <li>Test</li>
        <li>Test</li>
        
        
      </ul>
    </div>
    <div class="card" role="region" aria-labelledby="neg-title">
      <h2 id="neg-title" class="db-title-pink">Negative Traits</h2>
      <ul class="trait-list negative">
         <li>Test</li>
        <li>Test</li>
        <li>Test</li>
        <li>Test</li>
        <li>Test</li>
      </ul>
    </div>
  </section>

  <section class="card" role="region" aria-labelledby="gallery-title">
    <h2 id="gallery-title">Gallery</h2>
    <div class="gallery-grid">
      <figure>
        <Image src={nagiGallery1} class="pixelart" alt="Nagi drawing" loading="lazy" />
        <figcaption>Nagi drawing</figcaption>
      </figure>
      <figure>
        <Image src={nagiGallery2} class="pixelart" alt="Nagi drawing" loading="lazy" />
        <figcaption>Nagi drawing</figcaption>
      </figure>
      <figure>
        <Image src={nagiGallery3} class="pixelart" alt="Nagi drawing" loading="lazy" />
        <figcaption>Nagi drawing</figcaption>
      </figure>
      <figure>
        <Image src={nagiGallery4} class="pixelart" alt="Nagi drawing" loading="lazy" />
        <figcaption>Nagi drawing</figcaption>
      </figure>
    </div>
  </section>
  </div>
 </main>

<!-- Lightbox modal for gallery images -->
<div id="lightbox" class="lightbox-overlay" role="dialog" aria-modal="true" hidden tabindex="-1">
  <div class="lightbox-content">
    <button id="lightbox-close" class="lightbox-close" aria-label="Close image">×</button>
    <img class="lightbox-img" alt="Expanded image" />
  </div>
  <!-- click outside the image to close -->
  
</div>

<script is:inline type="module">
  const overlay = document.getElementById('lightbox');
  const overlayImg = overlay.querySelector('img');
  const closeBtn = document.getElementById('lightbox-close');

  function openLightbox(src) {
    overlayImg.src = src;
    overlay.hidden = false;
    overlay.focus();
  }

  function closeLightbox() {
    overlay.hidden = true;
    overlayImg.src = '';
  }

  // Make gallery images clickable
  document.querySelectorAll('.gallery-grid img').forEach((img) => {
    img.style.cursor = 'zoom-in';
    img.addEventListener('click', () => {
      // Prefer currentSrc when srcset is in use
      const src = img.currentSrc || img.src;
      openLightbox(src);
    });
    // Keyboard accessibility
    img.tabIndex = 0;
    img.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        const src = img.currentSrc || img.src;
        openLightbox(src);
      }
    });
  });

  // Close interactions
  closeBtn.addEventListener('click', closeLightbox);
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !overlay.hidden) closeLightbox();
  });
</script>

<Footer></Footer>
