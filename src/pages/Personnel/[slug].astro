---
import Header from '../../components/header.astro';
import Footer from '../../components/footer.astro';
import { Image } from 'astro:assets';
import personnelData from '../../data/personnel.json';

// Tell Astro which pages to build
// Build static paths for each character page from the personnel JSON.
export async function getStaticPaths() {
  return Object.keys(personnelData).map((slug) => ({ params: { slug } }));
}
//Describe the shape of our data (for TypeScript)
type GalleryItem = {
  file: string;
  caption: string;
};

type CharacterData = {
  name: string;
  position: string;
  species: string;
  gender: string;
  height: string;
  age: number;
  birthplace: string;
  profileImage: string;
  bio: string[];
  positiveTraits: string[];
  negativeTraits: string[];
  gallery: GalleryItem[];
  galleryAlt: string;
};

type PersonnelData = Record<string, CharacterData>;
const personnel = personnelData as PersonnelData;

//Find the character for this specific page

const { slug } = Astro.params;
const character = personnel[slug];

if (!character) {
  throw new Error(`Character not found: ${slug}`);
}

// Load all image assets and index them by folder and filename for the current character.
const galleryImages = Object.fromEntries(
  Object.entries(import.meta.glob('../../assets/images/*/*', { eager: true }) as Record<string, any>)
    .map(([path, mod]: [string, any]) => {
      const normalizedPath = path.replaceAll('\\', '/');
      const segments = normalizedPath.split('/');
      const key = segments.slice(-2).join('/');
      const value = (mod && typeof mod === 'object' && 'default' in mod) ? mod.default : mod;
      return [key, value];
    }),
) as Record<string, any>;
const base = (Astro as any).base ?? import.meta.env.BASE_URL ?? '';
const placeholderImage = `${base}/placeholder.png`;
const personnelBase = `${base}/Personnel`;

// Look up a gallery image by slug and filename.
// If the exact filename is not found, fall back to the same basename with any supported extension.
// Why this exists: sometimes the JSON says "profile.png"
//  but the actual file on disk is "profile.gif" or "profile.jpg".

const getGalleryImage = (slug: string, filename: string) => {
  const exactKey = `${slug}/${filename}`;
  if (exactKey in galleryImages) {
    return galleryImages[exactKey];
  }

  const basename = filename.replace(/\.[^/.]+$/, '');
  const fallbackKey = Object.keys(galleryImages).find((key) => {
    return key.startsWith(`${slug}/`) && key.replace(/^[^/]+\//, '').replace(/\.[^/.]+$/, '') === basename;
  });

  return fallbackKey ? galleryImages[fallbackKey] : undefined;
};

// Use the helper to resolve the profile image, including extension fallback.
const profileImport = getGalleryImage(slug, character.profileImage) ?? placeholderImage;
// Detect animated GIFs so we can render them with a native <img> tag and preserve animation.
const profileIsGif = /\.gif$/i.test(character.profileImage);
const profileIsPlaceholder = profileImport === placeholderImage;

//Turn bio text into clickable links
// Escape special regex characters so name matching is safe and accurate.
const escapeRegExp = (value: string): string => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
// Generate candidate links for all other characters, sorted longest-first to avoid partial matches.
const autoLinkCandidates = Object.entries(personnel)
  .filter(([otherSlug]) => otherSlug !== slug)
  .map(([otherSlug, data]) => ({ slug: otherSlug, name: data.name }))
  .sort((a, b) => b.name.length - a.name.length);

// Convert a bio paragraph into HTML, supporting explicit links and automatic character name links.
const parseBioParagraph = (paragraph: string): string => {
  const placeholders: string[] = [];

  const paragraphWithExplicitLinks = paragraph.replace(/<link=([^>]+)>(.*?)<\/link>/g, (_match: string, targetSlug: string, linkText: string) => {
    const html = `<a href="${personnelBase}/${targetSlug}">${linkText}</a>`;
    const placeholder = `__AUTO_LINK_PLACEHOLDER_${placeholders.length}__`;
    placeholders.push(html);
    return placeholder;
  });

  const segments = paragraphWithExplicitLinks.split(/(<[^>]+?>)/g);
  const linked = segments.map((segment: string) => {
    if (segment.startsWith('<')) {
      return segment;
    }

    let text = segment;
    for (const { name, slug: targetSlug } of autoLinkCandidates) {
      const nameRegex = new RegExp(`\\b${escapeRegExp(name)}\\b`, 'g');
      text = text.replace(nameRegex, `<a href="${personnelBase}/${targetSlug}">${name}</a>`);
    }
    return text;
  }).join('');

  return linked.replace(/__AUTO_LINK_PLACEHOLDER_(\d+)__/g, (_match: string, index: string) => placeholders[Number(index)] || '');
};
---

<Header />

<main>
  <div class="page-stack">
    <section class="card" role="article">
      <h1>{character.name} <span class="cursor" aria-hidden="true"></span></h1>
      <div class="profile">
        {profileIsGif || profileIsPlaceholder ? (
          <img src={profileImport} class="pixelart-profile" alt={`Profile image of ${character.name}`} loading="lazy" />
        ) : (
          <Image src={profileImport} class="pixelart-profile" quality={100} alt={`Profile image of ${character.name}`} />
        )}

        <dl class="info-dl">
          <div>
            <dt>Facility Position</dt>
            <dd>{character.position}</dd>
          </div>
          <div>
            <dt>Species</dt>
            <dd>{character.species}</dd>
          </div>
          <div>
            <dt>Gender</dt>
            <dd>{character.gender}</dd>
          </div>
          <div>
            <dt>Height</dt>
            <dd>{character.height}</dd>
          </div>
          <div>
            <dt>Age</dt>
            <dd>{character.age}</dd>
          </div>
          <div>
            <dt>Birthplace</dt>
            <dd>{character.birthplace}</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="card" role="region" aria-labelledby="bio-title">
      <h2 id="bio-title" class="db-title-cyan">Bio</h2>
      {character.bio.map((paragraph) => (
        <p set:html={parseBioParagraph(paragraph)}></p>
      ))}
    </section>

    <section class="traits-grid" aria-label="Traits">
      <div class="card" role="region" aria-labelledby="pos-title">
        <h2 id="pos-title" class="db-title-yellow">Positive Traits</h2>
        <ul class="trait-list positive">
          {character.positiveTraits.map((trait) => (
            <li>{trait}</li>
          ))}
        </ul>
      </div>
      <div class="card" role="region" aria-labelledby="neg-title">
        <h2 id="neg-title" class="db-title-pink">Negative Traits</h2>
        <ul class="trait-list negative">
          {character.negativeTraits.map((trait) => (
            <li>{trait}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="card" role="region" aria-labelledby="gallery-title">
      <h2 id="gallery-title">Gallery</h2>
      <div class="gallery-grid">
        {character.gallery.map((item) => {
          const imageSrc = getGalleryImage(slug, item.file) ?? placeholderImage;
          const isGif = /\.gif$/i.test(item.file);
          const isPlaceholder = imageSrc === placeholderImage;
          return (
            <figure>
              {isGif ? (
                <img src={imageSrc} class="pixelart" alt={character.galleryAlt} loading="lazy" />
              ) : isPlaceholder ? (
                <img src={imageSrc} class="pixelart" alt={character.galleryAlt} loading="lazy" />
              ) : (
                <Image src={imageSrc} class="pixelart" alt={character.galleryAlt} loading="lazy" />
              )}
              <figcaption>{item.caption}</figcaption>
            </figure>
          );
        })}
      </div>
    </section>
  </div>
</main>

<!-- Lightbox modal for gallery images -->
<div id="lightbox" class="lightbox-overlay" role="dialog" aria-modal="true" hidden tabindex="-1">
  <div class="lightbox-content">
    <button id="lightbox-close" class="lightbox-close" aria-label="Close image">×</button>
    <img class="lightbox-img" alt="Expanded image" />
  </div>
</div>

<Footer />
