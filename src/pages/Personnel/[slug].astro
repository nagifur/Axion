---
import Header from '../../components/header.astro';
import Footer from '../../components/footer.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import HoverText from '../../components/HoverText.astro';
import StatIcon from '../../components/StatIcon.astro';

// getStaticPaths tells Astro which pages to build. For a dynamic route for [slug].astro
export async function getStaticPaths() {
  // getCollection reads every Markdown file in the "personnel" content
  const entries = await getCollection('personnel', ({ data }) => !data.draft);

  // Turn each entry into a route. entry.id is the filename (e.g. "skye.md"),
  // Strip the extension to get a clean URL slug ("skye").
  return entries.map((entry) => {
    const slug = entry.id.replace(/\.md$/, '');

    return {
      params: { slug },
      props: { entry, slug },
    };
  });
}

const { entry, slug } = Astro.props;
// Markdown -> HTML step. It compiles the Markdown
// BODY of this entry (the free-text bio content below the frontmatter
// fence) into a renderable <Content /> component
const { Content } = await render(entry);
// structured data, like accessLevel, position, species, etc. is in entry.data
const { data: character } = entry;

// Load all image assets and index them by folder and filename for the current character.
const galleryImages = Object.fromEntries(
  Object.entries(import.meta.glob('../../assets/images/*/*', { eager: true }) as Record<string, any>)
    .map(([path, mod]: [string, any]) => {
      const normalizedPath = path.replaceAll('\\', '/');
      const segments = normalizedPath.split('/');
      const key = segments.slice(-2).join('/');
      const value = (mod && typeof mod === 'object' && 'default' in mod) ? mod.default : mod;
      return [key, value];
    }),
) as Record<string, any>;
const base = ((Astro as any).base ?? import.meta.env.BASE_URL ?? '').replace(/\/$/, '');
const placeholderImage = `${base}/placeholder.png`;
const personnelBase = `${base}/Personnel`;
// Link the access level stat to its Levels page when it's a known numeric level.
const accessLevelHref = /^\d+$/.test(String(character.accessLevel))
  ? `${base}/Levels/${character.accessLevel}`
  : undefined;

// Look up a gallery image by slug and filename.
// If the exact filename is not found, fall back to the same basename with any supported extension.
// Why this exists: sometimes the JSON says "profile.png"
//  but the actual file on disk is "profile.gif" or "profile.jpg".

const getGalleryImage = (slug: string, filename: string) => {
  const exactKey = `${slug}/${filename}`;
  if (exactKey in galleryImages) {
    return galleryImages[exactKey];
  }

  const basename = filename.replace(/\.[^/.]+$/, '');
  const fallbackKey = Object.keys(galleryImages).find((key) => {
    return key.startsWith(`${slug}/`) && key.replace(/^[^/]+\//, '').replace(/\.[^/.]+$/, '') === basename;
  });

  return fallbackKey ? galleryImages[fallbackKey] : undefined;
};

// Use the helper to resolve the profile image, including extension fallback.
const profileImport = getGalleryImage(slug, character.profileImage) ?? placeholderImage;
// Detect animated GIFs so we can render them with a native <img> tag and preserve animation.
const profileIsGif = /\.gif$/i.test(character.profileImage);
const profileIsPlaceholder = profileImport === placeholderImage;
---

<Header />

<main id="main" tabindex="-1">
  <div class="page-stack">
    <section class="card" role="article">
      <div class="profile-header">
        <h1 class="profile-name">{character.title}<span class="cursor" aria-hidden="true"></span></h1>
      </div>

      <div class="profile">
        <div class="profile-media">
          {profileIsGif || profileIsPlaceholder ? (
            <img src={profileImport} class="pixelart-profile" alt={`Profile image of ${character.title}`} loading="eager" fetchpriority="high" decoding="async" />
          ) : (
            <Image src={profileImport} class="pixelart-profile" quality={100} alt={`Profile image of ${character.title}`} loading="eager" fetchpriority="high" decoding="async" />
          )}
          <span class="profile-id">ID {character.employeeID}</span>
        </div>

        <div class="stat-grid">
          <div class="stat-cell">
           <span class="info-icon" aria-hidden="true"><StatIcon name="access" /> </span>Access Level
            <span class="stat-value">
              {accessLevelHref ? <a href={accessLevelHref}>Level {character.accessLevel}</a> : `Level ${character.accessLevel}`}
            </span>
          </div>
          <div class="stat-cell">
            <span class="info-icon" aria-hidden="true"><StatIcon name="position" /> </span>Facility Position
            <span class="stat-value"><HoverText value={character.position} /></span>
          </div>
          <div class="stat-cell">
            <span class="info-icon" aria-hidden="true"><StatIcon name="species" /> </span>Species
            <span class="stat-value"><HoverText value={character.species} /></span>
          </div>
          <div class="stat-cell">
            <span class="info-icon" aria-hidden="true"><StatIcon name="gender" /> </span>Gender
            <span class="stat-value"><HoverText value={character.gender} /></span>
          </div>
          <div class="stat-cell">
            <span class="info-icon" aria-hidden="true"><StatIcon name="height" /> </span>Height
            <span class="stat-value"><HoverText value={character.height} /></span>
          </div>
          <div class="stat-cell">
            <span class="info-icon" aria-hidden="true"><StatIcon name="age" /> </span>Age
            <span class="stat-value"><HoverText value={String(character.age)} /></span>
          </div>
          <div class="stat-cell">
            <span class="info-icon" aria-hidden="true"><StatIcon name="origin" /> </span>Birthplace
            <span class="stat-value"><HoverText value={character.birthplace} /></span>
          </div>
          <div class="stat-cell">
            <span class="info-icon" aria-hidden="true"><StatIcon name="trophic" /> </span>Trophic Role
            <span class="stat-value"><HoverText value={character.vorePreference?.length ? character.vorePreference.join(', ') : 'None'} /></span>
          </div>
        </div>
      </div>
    </section>

    <section class="card" role="region" aria-labelledby="bio-title">
      <h2 id="bio-title" class="db-title-cyan">Bio</h2>
      <div class="article-body">
        <Content />
      </div>
    </section>

    <section class="traits-grid" aria-label="Traits">
      <div class="card" role="region" aria-labelledby="pos-title">
        <h2 id="pos-title" class="db-title-green">Positive Traits</h2>
        <ul class="trait-list positive">
          {character.positiveTraits.length ? character.positiveTraits.map((trait) => (
            <li><HoverText value={trait} /></li>
          )) : <li>None</li>}
        </ul>
      </div>
      <div class="card" role="region" aria-labelledby="neg-title">
        <h2 id="neg-title" class="db-title-red">Negative Traits</h2>
        <ul class="trait-list negative">
          {character.negativeTraits.length ? character.negativeTraits.map((trait) => (
            <li><HoverText value={trait} /></li>
          )) : <li>None</li>}
        </ul>
      </div>
    </section>

    <section class="card" role="region" aria-labelledby="gallery-title">
      <h2 id="gallery-title">Gallery</h2>
      <div class="gallery-grid">
        {character.gallery.map((item) => {
          const imageSrc = getGalleryImage(slug, item.file) ?? placeholderImage;
          const isGif = /\.gif$/i.test(item.file);
          const isPlaceholder = imageSrc === placeholderImage;
          return (
            <figure>
              {isGif ? (
                <img src={imageSrc} class="pixelart" alt={`${character.galleryAlt} — ${item.caption}`} data-caption={item.caption} loading="lazy" decoding="async" />
              ) : isPlaceholder ? (
                <img src={imageSrc} class="pixelart" alt={`${character.galleryAlt} — ${item.caption}`} data-caption={item.caption} loading="lazy" decoding="async" />
              ) : (
                <Image src={imageSrc} class="pixelart" alt={`${character.galleryAlt} — ${item.caption}`} data-caption={item.caption} loading="lazy" />
              )}
              <figcaption><HoverText value={item.caption} /></figcaption>
            </figure>
          );
        })}
      </div>
    </section>
  </div>
</main>

<!-- Lightbox modal for gallery images -->
<div id="lightbox" class="lightbox-overlay" role="dialog" aria-modal="true" hidden tabindex="-1">
  <div class="lightbox-content">
    <button id="lightbox-close" class="lightbox-close" aria-label="Close image">×</button>
    <img class="lightbox-img" alt="" />
  </div>
</div>

<Footer />
