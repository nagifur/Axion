---
import Header from  '../../components/header.astro';
import Footer from '../../components/footer.astro';
import { Image } from 'astro:assets';
import Profile from "../../assets/images/somni/profile.png";
import Gallery1 from "../../assets/images/somni/1.png";
import Gallery2 from "../../assets/images/somni/2.png";
import Gallery3 from "../../assets/images/somni/3.png";
import Gallery4 from "../../assets/images/somni/4.png";
---
<Header></Header>

<main>
  <div class="page-stack">
  <section class="card" role="article">
    <h1 id="heading">Somni <span class="cursor" aria-hidden="true"></span></h1>
    <div class="profile">
      <Image src={Profile} class="pixelart-profile" quality={100} alt="A description of my image." />

      <dl class="info-dl">
        <div>
          <dt>Facility Position</dt>
          <dd>Containment Unit</dd>
        </div>
        <div>
          <dt>Species</dt>
          <dd>Feline </dd>
        </div>
        <div>
          <dt>Gender</dt>
          <dd>Female</dd>
        </div>
        <div>
          <dt>Age</dt>
          <dd>23</dd>
        </div>
        <div>
          <dt>Birthplace</dt>
          <dd style="color: red;">-TBN-</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="card" role="region" aria-labelledby="bio-title">
    <h2 id="bio-title" class="db-title-cyan">Bio</h2>
    <p >Somni is a level 3 containment unit specialist at Axion, known for her expertise in handling any threat and all kinds of alien creatures. 
        She has a calm and composed demeanor, which makes her highly effective in high-pressure situations. 
      
      </p>
      <p>
        Born on the planet, <b style="color: red;">-TBN-</b>, Somni decided to join Axion after her desire to get away from her home planet. After a background check with 
        her government, it seem she was an outcast among her people. She was then recruited by Axion, and has been working with them ever since.
      </p>
      <p>
        Somni is in possesion of highly powerful <b>ESP abilities</b>, which she uses to her advantage in her work. It is a new type of magic, that is
        not present on Axion's home planet. She is also a skilled combatant, and is able to take down any threat that comes her way. Due to her powers
        she was able to ace all of our combat training, and is now one of our top <b>containment</b> agents.</section>

  <section class="traits-grid" aria-label="Traits">
    <div class="card" role="region" aria-labelledby="pos-title">
      <h2 id="pos-title" class="db-title-yellow">Positive Traits</h2>
      <ul class="trait-list positive">
        <li>Strong</li>
        <li>Dependant</li>
        <li>Magical</li>
        <li>Efficient</li>
        
        
      </ul>
    </div>
    <div class="card" role="region" aria-labelledby="neg-title">
      <h2 id="neg-title" class="db-title-pink">Negative Traits</h2>
      <ul class="trait-list negative">
         <li>Sleepy</li>
        <li>Short</li>
        <li>Cannot work for extended periods</li>
        
      </ul>
    </div>
  </section>

  <section class="card" role="region" aria-labelledby="gallery-title">
    <h2 id="gallery-title">Gallery</h2>
    <div class="gallery-grid">
      <figure>
        <Image src={Gallery1} class="pixelart" alt="Nagi drawing" loading="lazy" />
        <figcaption>ID Card</figcaption>
      </figure>
      <figure>
        <Image src={Gallery2} class="pixelart" alt="Nagi drawing" loading="lazy" />
        <figcaption>Working</figcaption>
      </figure>
      <figure>
        <Image src={Gallery3} class="pixelart" alt="Nagi drawing" loading="lazy" />
        <figcaption>Casual</figcaption>
      </figure>
      <figure>
        <Image src={Gallery4} class="pixelart" alt="Nagi drawing" loading="lazy" />
        <figcaption>Closeup</figcaption>
      </figure>
    </div>
  </section>
  </div>
 </main>

<!-- Lightbox modal for gallery images -->
<div id="lightbox" class="lightbox-overlay" role="dialog" aria-modal="true" hidden tabindex="-1">
  <div class="lightbox-content">
    <button id="lightbox-close" class="lightbox-close" aria-label="Close image">×</button>
    <img class="lightbox-img" alt="Expanded image" />
  </div>
  <!-- click outside the image to close -->
  
</div>



<Footer></Footer>
