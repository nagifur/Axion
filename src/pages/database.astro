---
import Header from  '../components/header.astro';
import Footer from '../components/footer.astro';
import HoverText from '../components/HoverText.astro';
import DatabaseFolderIcon from '../components/DatabaseFolderIcon.astro';
import { getCollection } from 'astro:content';

const personnel = await getCollection('personnel', ({ data }) => !data.draft);
const entities = await getCollection('entities', ({ data }) => !data.draft);
const contentSlug = (id: string) => id.replace(/\.md$/, '');
const activePersonnelUrls = personnel.map((entry) => `/Personnel/${contentSlug(entry.id)}`);
const activeEntityUrls = entities.map((entry) => `/Entities/${contentSlug(entry.id)}`);
const publishedArticles = await getCollection('articles', ({ data }) => !data.draft);
const activeArticleUrls = publishedArticles.map((article) => `/Articles/${article.slug}`);
const reportsByCategory = Array.from(
  publishedArticles.reduce((groups, article) => {
    const category = article.data.category.trim() || 'Uncategorized';
    const categoryReports = groups.get(category) ?? [];
    categoryReports.push(article);
    groups.set(category, categoryReports);
    return groups;
  }, new Map<string, typeof publishedArticles>()),
  ([category, reports]) => ({
    category,
    reports: reports.sort((first, second) => first.data.title.localeCompare(second.data.title)),
  }),
).sort((first, second) => first.category.localeCompare(second.category));
const activeClassUrls = ['a', 's', 'c', 'm', 'x'].map((cls) => `/Classes/${cls}`);
const activeLevelUrls = [0, 1, 2, 3, 4, 5].map((level) => `/Levels/${level}`);
type EntityGroup = {
  title: string;
  entries: { href: string; label: string }[];
  note?: string;
};

const maximumContainmentEntries = entities
  .filter((entry) => entry.data.containmentClass === 'Maximum Containment')
  .map((entry) => ({
    href: `/Entities/${contentSlug(entry.id)}`,
    label: entry.data.title,
  }));

const safeEntries = Array.from(
  new Map(
    [
      { href: '/Entities/s-002', label: 'S-002 - (Wisp Animation)' },
      { href: '/Entities/s-003', label: 'S-003 - (A1 Tail Vore Animation)' },
      { href: '/Entities/s-013', label: 'S-013 - (Soul Mirror)' },
      { href: '/Entities/s-382', label: 'S-382 - (Mentioned in Not Enough Sleep)' },
      { href: '/Entities/s-420', label: 'S-420 - (Star Mushrooms)' },
      { href: '/Entities/s-552', label: 'S-552 - (Sprouty)' },
      { href: '/Entities/s-688', label: 'S-688 - (Genesis Chroma)' },
      ...entities
        .filter((entry) => entry.data.containmentClass === 'Safe')
        .map((entry) => ({
          href: `/Entities/${contentSlug(entry.id)}`,
          label: entry.data.title,
        })),
    ].map((entry) => [entry.href, entry] as const),
  ),
).map(([, entry]) => entry)
  .sort((first, second) => first.label.localeCompare(second.label));

const unassignedEntries = Array.from(
  new Map(
    [
      { href: '/Entities/x-402', label: 'X-402' },
      { href: '/Entities/x-403', label: 'X-403' },
      ...entities
        .filter((entry) => entry.data.containmentClass === 'Unassigned')
        .map((entry) => ({
          href: `/Entities/${contentSlug(entry.id)}`,
          label: entry.data.title,
        })),
    ].map((entry) => [entry.href, entry] as const)),
  ).map(([, entry]) => entry)
  .sort((first, second) => first.label.localeCompare(second.label));

const entityGroups: { left: EntityGroup[]; right: EntityGroup[] } = {
  left: [
    {
      title: 'Class A',
      entries: [
        { href: '/Personnel/a1', label: 'A-001' },
        { href: '/Entities/a-071', label: 'A-071 (Levi)' },
        { href: '/Personnel/somni', label: 'A-100' },
      ],
    },
    {
      title: 'Class S',
      entries: safeEntries,
    },
  ],
  right: [
    {
      title: 'Class C',
      entries: [
        { href: '/Entities/c-086', label: 'C-086 - (Bloom Lizard)' },
        { href: '/Entities/c-2221', label: 'C-221 - (Wisp Animation)' },
        { href: '/Entities/c-282', label: 'C-282 - (Eyless lizard)' },
        { href: '/Entities/c-324', label: 'C-324 - (Tentacle Plant)' },
        { href: '/Entities/c-400', label: 'C-400 - (Portal Cats)' },
        { href: '/Entities/c-668', label: 'C-668 - (Wisp Animation)' },
      ],
    },
    {
      title: 'Class M',
      entries: [
        ...maximumContainmentEntries,
        { href: '/Entities/m-227', label: 'M-227 - (Spore Lizard)' },
      ],
    },
    {
      title: 'Unassigned',
      entries: unassignedEntries,
    },
  ],
};

const personnelByAccessLevel = [0, 1, 2, 3, 4, 5].map((level) => ({
  level,
  members: personnel
    .filter((entry) => Number(entry.data.accessLevel ?? 1) === level)
    .sort((first, second) => first.data.title.localeCompare(second.data.title)),
}));

// Keep a lookup set for active link styling.
const activeUrls = new Set([
  ...activePersonnelUrls,
  ...activeEntityUrls,
  ...activeArticleUrls,
  ...activeClassUrls,
  ...activeLevelUrls,
]);
// Keep a lookup set of links flagged as Patreon submissions.
const patreonUrls = new Set([
  ...personnel.filter((entry) => entry.data.patreonSubmission).map((entry) => `/Personnel/${contentSlug(entry.id)}`),
  ...entities.filter((entry) => entry.data.patreonSubmission).map((entry) => `/Entities/${contentSlug(entry.id)}`),
  ...publishedArticles.filter((article) => article.data.patreonSubmission).map((article) => `/Articles/${article.slug}`),
]);
// Determine whether a given link target is currently active.
const linkState = (href: string): 'active' | 'inactive' => activeUrls.has(href) ? 'active' : 'inactive';
// Combine active state with the Patreon-submission highlight, if applicable.
const linkClass = (href: string) => patreonUrls.has(href) ? `${linkState(href)} patreon` : linkState(href);
---
<Header
  title="Database"
  description="Browse the Axion Labs facility database of personnel, entities, and classifications."
/>

<main id="main" tabindex="-1">
  <section class="card db-shell" aria-labelledby="db-title">
    <h1 id="db-title">Facility Database <span class="cursor" aria-hidden="true"></span></h1>
    <p class="lead">Browse internal docs by category.</p>

    <div class="db-pane-nav-wrap">
      <nav class="db-pane-nav" role="tablist" aria-label="Database folders">
        <button id="db-tab-personnel" class="db-tab" role="tab" type="button" aria-selected="true" aria-controls="db-panel-personnel" tabindex="0"><DatabaseFolderIcon />Personnel</button>
        <button id="db-tab-entities" class="db-tab" role="tab" type="button" aria-selected="false" aria-controls="db-panel-entities" tabindex="-1"><DatabaseFolderIcon />Entities</button>
        <button id="db-tab-containment" class="db-tab" role="tab" type="button" aria-selected="false" aria-controls="db-panel-containment" tabindex="-1"><DatabaseFolderIcon />Containment Classes</button>
        <button id="db-tab-levels" class="db-tab" role="tab" type="button" aria-selected="false" aria-controls="db-panel-levels" tabindex="-1"><DatabaseFolderIcon />Levels</button>
        <button id="db-tab-articles" class="db-tab" role="tab" type="button" aria-selected="false" aria-controls="db-panel-articles" tabindex="-1"><DatabaseFolderIcon />Reports</button>
      </nav>
      <span class="db-scroll-cue" aria-hidden="true">›</span>
    </div>

    <div class="db-pane-right">
      <div class="card compact db-legend" aria-labelledby="sec-link-legend">
        
        <h2 id="sec-link-legend" class="db-title-cyan">Filters</h2>
        <ul class="db-legend-list">
          <li class="db-legend-item"><button type="button" class="db-legend-swatch db-legend-cyan db-legend-filter" data-db-filter="canon" aria-pressed="false">Cyan</button> - Canon </li>
          <li class="db-legend-item"><button type="button" class="db-legend-swatch db-legend-red db-legend-filter" data-db-filter="unavailable" aria-pressed="false">Red</button> - Unavailable</li>
          <li class="db-legend-item"><button type="button" class="db-legend-swatch db-legend-orange db-legend-filter" data-db-filter="patreon" aria-pressed="false"><HoverText value={'{{Orange | May not be canon}}'} /></button> - Patreon submission</li>
        </ul>
        <p class="db-legend-hint" data-db-filter-hint hidden>Filtering active. Click the highlighted color again to show everything.</p>
      </div>

      <div class="db-panels">
        <section id="db-panel-personnel" class="db-panel db-panel-active" role="tabpanel" aria-labelledby="db-tab-personnel">
          <div class="card compact" aria-labelledby="sec-personnel">
            <div class="db-section-tree">
              <h2 id="sec-personnel" class="db-title-yellow db-title-node"><DatabaseFolderIcon />Personnel</h2>
              <div class="db-section-branch">
                <div class="db-content-grid db-tree">
                  <div class="db-content-column">
                    {personnelByAccessLevel.map((group) => (
                      <section class="db-group" aria-label={`Personnel level ${group.level}`}>
                        <h3 class="db-section-title"><DatabaseFolderIcon />Level {group.level}</h3>
                        <ul class="db-list db-sublist">
                          {group.members.map((person) => (
                            <li><a href={`/Personnel/${contentSlug(person.id)}`} class={linkClass(`/Personnel/${contentSlug(person.id)}`)}>{person.data.title}</a></li>
                          ))}
                        </ul>
                      </section>
                    ))}
                    <section class="db-group" aria-label="Special personnel">
                      <h3 class="db-section-title"><DatabaseFolderIcon />Special</h3>
                      <ul class="db-list db-sublist">
                        <li><a href="/Personnel/sypher" class={linkClass('/Personnel/sypher')}>Sypher</a></li>
                      </ul>
                    </section>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section id="db-panel-entities" class="db-panel" role="tabpanel" aria-labelledby="db-tab-entities" hidden>
          <div class="card compact" aria-labelledby="sec-entities">
            <div class="db-section-tree">
              <h2 id="sec-entities" class="db-title-blue db-title-node"><DatabaseFolderIcon />Entities</h2>
              <div class="db-section-branch">
                <div class="db-content-grid db-tree">
                  <div class="db-content-column">
                    {[...entityGroups.left, ...entityGroups.right].map((group) => (
                      <section class="db-group" aria-label={group.title}>
                        <h3 class="db-section-title"><DatabaseFolderIcon />{group.title}</h3>
                        {group.note && <p class="db-group-note">{group.note}</p>}
                        <ul class="db-list db-sublist">
                          {group.entries.map((entry) => (
                            <li><a href={entry.href} class={linkClass(entry.href)}>{entry.label}</a></li>
                          ))}
                        </ul>
                      </section>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section id="db-panel-containment" class="db-panel" role="tabpanel" aria-labelledby="db-tab-containment" hidden>
          <div class="card compact" aria-labelledby="sec-containment">
            <div class="db-section-tree">
              <h2 id="sec-containment" class="db-title-cyan db-title-node"><DatabaseFolderIcon />Containment Classes</h2>
              <div class="db-section-branch">
                <ul class="db-list db-tree-list">
                  <li><a href="/Classes/a" class={linkState('/Classes/a')}>A - Ally</a></li>
                  <li><a href="/Classes/s" class={linkState('/Classes/s')}>S - Safe </a></li>
                  <li><a href="/Classes/c" class={linkState('/Classes/c')}>C - Containment </a></li>
                  <li><a href="/Classes/m" class={linkState('/Classes/m')}>M - Maximum Containment </a></li>
                  <li><a href="/Classes/x" class={linkState('/Classes/x')}>X - Unassigned</a></li>
                </ul>
              </div>
            </div>
          </div>
        </section>

        <section id="db-panel-levels" class="db-panel" role="tabpanel" aria-labelledby="db-tab-levels" hidden>
          <div class="card compact" aria-labelledby="sec-levels">
            <div class="db-section-tree">
              <h2 id="sec-levels" class="db-title-pink db-title-node"><DatabaseFolderIcon />Levels</h2>
              <div class="db-section-branch">
                <ul class="db-list db-tree-list">
                  <li><a href="/Levels/0" class={linkState('/Levels/0')}>Level 0</a></li>
                  <li><a href="/Levels/1" class={linkState('/Levels/1')}>Level 1</a></li>
                  <li><a href="/Levels/2" class={linkState('/Levels/2')}>Level 2</a></li>
                  <li><a href="/Levels/3" class={linkState('/Levels/3')}>Level 3</a></li>
                  <li><a href="/Levels/4" class={linkState('/Levels/4')}>Level 4</a></li>
                  <li><a href="/Levels/5" class={linkState('/Levels/5')}>Level 5</a></li>
                </ul>
              </div>
            </div>
          </div>
        </section>

        <section id="db-panel-articles" class="db-panel" role="tabpanel" aria-labelledby="db-tab-articles" hidden>
          <div class="card compact" aria-labelledby="sec-articles">
            <div class="db-section-tree">
              <h2 id="sec-articles" class="db-title-blue db-title-node"><DatabaseFolderIcon />Reports </h2>
              <div class="db-section-branch">
                {publishedArticles.length > 0 ? (
                  <div class="db-content-grid db-tree">
                    <div class="db-content-column">
                      {reportsByCategory.map((group) => (
                        <section class="db-group" aria-label={`${group.category} reports`}>
                          <h3 class="db-section-title"><DatabaseFolderIcon />{group.category}</h3>
                          <ul class="db-list db-sublist">
                            {group.reports.map((article) => (
                              <li>
                                <a href={`/Articles/${article.slug}`} class={linkClass(`/Articles/${article.slug}`)}>
                                  {article.data.title}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </section>
                      ))}
                    </div>
                  </div>
                ) : (
                  <p class="db-group-note">No published reports yet.</p>
                )}
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
  </section>
</main>
<Footer></Footer>
