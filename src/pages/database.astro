---
import Header from  '../components/header.astro';
import Footer from '../components/footer.astro';
import personnelData from '../data/personnel.json';
import entityData from '../data/entities.json';
import { getCollection } from 'astro:content';

// Build all personnel page URLs from the JSON data.
const activePersonnelUrls = Object.keys(personnelData).map((slug: string) => `/Axion/Personnel/${slug}`);
// Build all entity page URLs from the JSON data.
const activeEntityUrls = Object.keys(entityData).map((slug: string) => `/Axion/Entities/${slug}`);
const publishedArticles = await getCollection('articles', ({ data }) => !data.draft);
const activeArticleUrls = [
  '/Axion/Articles/',
  ...publishedArticles.map((article) => `/Axion/Articles/${article.slug}`),
];

const personnelByAccessLevel = [1, 2, 3, 4, 5].map((level) => ({
  level,
  members: Object.values(personnelData)
    .filter((person: any) => Number(person.accessLevel ?? 1) === level)
    .sort((a: any, b: any) => a.name.localeCompare(b.name)),
}));

// Keep a lookup set for active link styling.
const activeUrls = new Set([...activePersonnelUrls, ...activeEntityUrls, ...activeArticleUrls]);
// Determine whether a given link target is currently active.
const linkState = (href: string): 'active' | 'inactive' => activeUrls.has(href) ? 'active' : 'inactive';
---
<Header></Header>

<main>
  <section class="card" role="navigation" aria-labelledby="db-title">
    <h1 id="db-title">Facility Database <span class="cursor" aria-hidden="true"></span></h1>
    <p class="lead">Browse internal docs by category.</p>

    <div class="db-grid">
      <div class="card compact db-legend" aria-labelledby="sec-link-legend">
        <h2 id="sec-link-legend" class="db-title-cyan">Link Legend</h2>
        <ul class="db-legend-list">
          <li class="db-legend-item"><span class="db-legend-swatch db-legend-cyan">Cyan</span> - Canon </li>
          <li class="db-legend-item"><span class="db-legend-swatch db-legend-red">Red</span> - Canon (unavailable)</li>
          <li class="db-legend-item"><span class="db-legend-swatch db-legend-orange">Orange</span> - Patreon submission</li>
        </ul>
      </div>

      <div class="card compact" aria-labelledby="sec-personnel">
        <h2 id="sec-personnel" class="db-title-yellow">Personnel</h2>

        <ul class="db-list">
          {personnelByAccessLevel.map(({ level, members }) => (
            <li>
              Level {level}:
              <ul class="db-list">
                {members.map((person: any) => (
                  <li>
                    <a href={`/Axion/Personnel/${person.slug}`} class={linkState(`/Axion/Personnel/${person.slug}`)}>
                      {person.name}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))}
          <li>
            Special:
            <ul class="db-list">
              <li>
                <a href="/Axion/Personnel/sypher" class={linkState('/Axion/Personnel/sypher')}>
                  Sypher
                </a>
              </li>
          
          </li>
        </ul>
      </div>

      <div class="card compact" aria-labelledby="sec-levels">
        <h2 id="sec-levels" class="db-title-pink">Levels</h2>
        <ul class="db-list">
          <li><a href="#" class={linkState('#')}>Level 1</a></li>
          <li><a href="#" class={linkState('#')}>Level 2</a></li>
          <li><a href="#" class={linkState('#')}>Level 3</a></li>
          <li><a href="#" class={linkState('#')}>Level 4</a></li>
          <li><a href="#" class={linkState('#')}>Level 5</a></li>
        </ul>
      </div>

      <div class="card compact" aria-labelledby="sec-entities">
        <h2 id="sec-entities" class="db-title-blue">Entities</h2>
        <ul class="db-list">
          <li> Class A
           
              <ul class="db-list">
                <li><a href="/Axion/Personnel/a1" class={linkState('/Axion/Personnel/a1')}>A-001</a></li>
                <li><a href="/Axion/Entities/a-071" class={linkState('/Axion/Entities/a-071')}>A-071 (Levi)</a></li>
                 <li><a href="/Axion/Entities/a-100" class={linkState('/Axion/Entities/a-100')}>A-100</a></li>
              </ul>
          </li>

          <li> Class S
           
            <ul class="db-list">
<li><a href="/Axion/Entities/s-002" class={linkState('/Axion/Entities/s-002')}>S-002 - (Wisp Animation)</a></li>
                <li><a href="/Axion/Entities/s-003" class={linkState('/Axion/Entities/s-003')}>S-003 - (A1 Tail Vore Animation)</a></li>
                <li><a href="/Axion/Entities/s-013" class={linkState('/Axion/Entities/s-013')}>S-013 - (Soul Mirror)</a></li>
                  <li><a href="/Axion/Entities/s-402" class={linkState('/Axion/Entities/s-402')}>S-402 - (Alien Alcoholic)</a></li>
                  <li><a href="/Axion/Entities/s-382" class={linkState('/Axion/Entities/s-382')}>S-382 - (Mentioned in Not Enough Sleep)</a></li>
                <li><a href="/Axion/Entities/s-420" class={linkState('/Axion/Entities/s-420')}>S-420 - (Star Mushrooms)</a></li>
                <li><a href="/Axion/Entities/s-552" class={linkState('/Axion/Entities/s-552')}>S-552 - (Sprouty)</a></li>
                <li><a href="/Axion/Entities/s-688" class={linkState('/Axion/Entities/s-688')}>S-688 - (Genesis Chroma)</a></li>
                 
              </ul>
          </li>

          <li> Class C
           
              <ul class="db-list">
                <li><a href="/Axion/Entities/c-086" class={linkState('/Axion/Entities/c-086')}>C-086 - (Bloom Lizard)</a></li>
                <li><a href="/Axion/Entities/c-2221" class={linkState('/Axion/Entities/c-2221')}>C-221 - (Wisp Animation)</a></li>
                <li><a href="/Axion/Entities/c-282" class={linkState('/Axion/Entities/c-282')}>C-282 - (Eyless lizard)</a></li>
                <li><a href="/Axion/Entities/c-324" class={linkState('/Axion/Entities/c-324')}>C-324 - (Tentacle Plant)</a></li>
                <li><a href="/Axion/Entities/c-400" class={linkState('/Axion/Entities/c-400')}>C-400 - (Portal Cats)</a></li>
                <li><a href="/Axion/Entities/c-668" class={linkState('/Axion/Entities/c-668')}>C-668 - (Wisp Animation)</a></li>
                 
              </ul>
          </li>

          <li> Class M
           
              <ul class="db-list">
                <li><a href="/Axion/Entities/m-031" class={linkState('/Axion/Entities/m-031')}>M-031</a></li>
                <li><a href="/Axion/Entities/m-227" class={linkState('/Axion/Entities/m-227')}>M-227 - (Spore Lizard)</a></li>
               
              </ul>
          </li>
          <hr>
          <li> UNASSIGNED
           
              <ul class="db-list">
                X-001.....X-401
                <li><a href="/Axion/Entities/x-402" class={linkState('/Axion/Entities/x-402')}>X-402</a></li>
                <li><a href="/Axion/Entities/x-403" class={linkState('/Axion/Entities/x-403')}>X-403</a></li>
                
        </ul>
      </div>

      <div class="card compact" aria-labelledby="sec-containment">
        <h2 id="sec-containment" class="db-title-cyan">Containment Classes</h2>
        <ul class="db-list">
          <li><a href="#" class={linkState('#')}>A - Ally</a></li>
          <li><a href="#" class={linkState('#')}>S - Safe </a></li>
          <li><a href="#" class={linkState('#')}>C - Containment </a></li>
          <li><a href="#" class={linkState('#')}>M - Maximum Containment </a></li>
          
        </ul>
      </div>

      <div class="card compact" aria-labelledby="sec-articles">
        <h2 id="sec-articles" class="db-title-blue">Articles</h2>
        <ul class="db-list">
          <li>
            <a href="/Axion/Articles/" class={linkState('/Axion/Articles/')}>Browse Archive</a>
            {publishedArticles.length > 0 && (
              <ul class="db-list">
                {publishedArticles.map((article) => (
                  <li>
                    <a href={`/Axion/Articles/${article.slug}`} class={linkState(`/Axion/Articles/${article.slug}`)}>
                      {article.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        </ul>
      </div>


    </div>
  </section>
</main>
<Footer></Footer>
