---
import Header from  '../components/header.astro';
import Footer from '../components/footer.astro';
import { getCollection } from 'astro:content';

const personnel = await getCollection('personnel', ({ data }) => !data.draft);
const entities = await getCollection('entities', ({ data }) => !data.draft);
const contentSlug = (id: string) => id.replace(/\.md$/, '');
const activePersonnelUrls = personnel.map((entry) => `/Axion/Personnel/${contentSlug(entry.id)}`);
const activeEntityUrls = entities.map((entry) => `/Axion/Entities/${contentSlug(entry.id)}`);
const publishedArticles = await getCollection('articles', ({ data }) => !data.draft);
const activeArticleUrls = [
  '/Axion/Articles/',
  ...publishedArticles.map((article) => `/Axion/Articles/${article.slug}`),
];
const activeClassUrls = ['a', 's', 'c', 'm'].map((cls) => `/Axion/Classes/${cls}`);
const activeLevelUrls = [0, 1, 2, 3, 4, 5].map((level) => `/Axion/Levels/${level}`);
const personnelColumns = {
  left: [0, 1, 2, 3],
  right: [4, 5],
};

type EntityGroup = {
  title: string;
  entries: { href: string; label: string }[];
  note?: string;
};

const entityGroups: { left: EntityGroup[]; right: EntityGroup[] } = {
  left: [
    {
      title: 'Class A',
      entries: [
        { href: '/Axion/Personnel/a1', label: 'A-001' },
        { href: '/Axion/Entities/a-071', label: 'A-071 (Levi)' },
        { href: '/Axion/Personnel/somni', label: 'A-100' },
      ],
    },
    {
      title: 'Class S',
      entries: [
        { href: '/Axion/Entities/s-002', label: 'S-002 - (Wisp Animation)' },
        { href: '/Axion/Entities/s-003', label: 'S-003 - (A1 Tail Vore Animation)' },
        { href: '/Axion/Entities/s-013', label: 'S-013 - (Soul Mirror)' },
        { href: '/Axion/Entities/s-402', label: 'S-402 - (Alien Alcoholic)' },
        { href: '/Axion/Entities/s-382', label: 'S-382 - (Mentioned in Not Enough Sleep)' },
        { href: '/Axion/Entities/s-420', label: 'S-420 - (Star Mushrooms)' },
        { href: '/Axion/Entities/s-552', label: 'S-552 - (Sprouty)' },
        { href: '/Axion/Entities/s-688', label: 'S-688 - (Genesis Chroma)' },
      ],
    },
  ],
  right: [
    {
      title: 'Class C',
      entries: [
        { href: '/Axion/Entities/c-086', label: 'C-086 - (Bloom Lizard)' },
        { href: '/Axion/Entities/c-2221', label: 'C-221 - (Wisp Animation)' },
        { href: '/Axion/Entities/c-282', label: 'C-282 - (Eyless lizard)' },
        { href: '/Axion/Entities/c-324', label: 'C-324 - (Tentacle Plant)' },
        { href: '/Axion/Entities/c-400', label: 'C-400 - (Portal Cats)' },
        { href: '/Axion/Entities/c-668', label: 'C-668 - (Wisp Animation)' },
      ],
    },
    {
      title: 'Class M',
      entries: [
        { href: '/Axion/Entities/m-031', label: 'M-031' },
        { href: '/Axion/Entities/m-227', label: 'M-227 - (Spore Lizard)' },
      ],
    },
    {
      title: 'Unassigned',
      entries: [
        { href: '/Axion/Entities/x-402', label: 'X-402' },
        { href: '/Axion/Entities/x-403', label: 'X-403' },
      ],
      
    },
  ],
};

const personnelByAccessLevel = [0, 1, 2, 3, 4, 5].map((level) => ({
  level,
  members: personnel
    .filter((entry) => Number(entry.data.accessLevel ?? 1) === level)
    .sort((first, second) => first.data.title.localeCompare(second.data.title)),
}));

// Keep a lookup set for active link styling.
const activeUrls = new Set([
  ...activePersonnelUrls,
  ...activeEntityUrls,
  ...activeArticleUrls,
  ...activeClassUrls,
  ...activeLevelUrls,
]);
// Determine whether a given link target is currently active.
const linkState = (href: string): 'active' | 'inactive' => activeUrls.has(href) ? 'active' : 'inactive';
---
<Header></Header>

<main id="main" tabindex="-1">
  <section class="card db-shell" aria-labelledby="db-title">
    <h1 id="db-title">Facility Database <span class="cursor" aria-hidden="true"></span></h1>
    <p class="lead">Browse internal docs by category.</p>

    <nav class="db-pane-nav" role="tablist" aria-label="Database categories">
      <button id="db-tab-personnel" class="db-tab" role="tab" type="button" aria-selected="true" aria-controls="db-panel-personnel" tabindex="0">Personnel</button>
      <button id="db-tab-entities" class="db-tab" role="tab" type="button" aria-selected="false" aria-controls="db-panel-entities" tabindex="-1">Entities</button>
      <button id="db-tab-containment" class="db-tab" role="tab" type="button" aria-selected="false" aria-controls="db-panel-containment" tabindex="-1">Containment Classes</button>
      <button id="db-tab-levels" class="db-tab" role="tab" type="button" aria-selected="false" aria-controls="db-panel-levels" tabindex="-1">Levels</button>
      <button id="db-tab-articles" class="db-tab" role="tab" type="button" aria-selected="false" aria-controls="db-panel-articles" tabindex="-1">Articles</button>
    </nav>

    <div class="db-pane-right">
      <div class="card compact db-legend" aria-labelledby="sec-link-legend">
        <h2 id="sec-link-legend" class="db-title-cyan">Link Legend</h2>
        <ul class="db-legend-list">
          <li class="db-legend-item"><span class="db-legend-swatch db-legend-cyan">Cyan</span> - Canon </li>
          <li class="db-legend-item"><span class="db-legend-swatch db-legend-red">Red</span> - Unavailable</li>
          <li class="db-legend-item"><span class="db-legend-swatch db-legend-orange">Orange</span> - Patreon submission</li>
        </ul>
      </div>

      <div class="db-panels">
        <section id="db-panel-personnel" class="db-panel db-panel-active" role="tabpanel" aria-labelledby="db-tab-personnel">
          <div class="card compact" aria-labelledby="sec-personnel">
            <h2 id="sec-personnel" class="db-title-yellow">Personnel</h2>
            <div class="db-content-grid">
              <div class="db-content-column">
                {personnelColumns.left.map((level) => {
                  const group = personnelByAccessLevel.find((entry) => entry.level === level);
                  return group ? (
                    <section class="db-group" aria-label={`Personnel level ${level}`}>
                      <h3 class="db-section-title">Level {level}</h3>
                      <ul class="db-list db-sublist">
                        {group.members.map((person) => (
                          <li>
                            <a href={`/Axion/Personnel/${contentSlug(person.id)}`} class={linkState(`/Axion/Personnel/${contentSlug(person.id)}`)}>
                              {person.data.title}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </section>
                  ) : null;
                })}

                <section class="db-group" aria-label="Special personnel">
                  <h3 class="db-section-title">Special</h3>
                  <ul class="db-list db-sublist">
                    <li>
                      <a href="/Axion/Personnel/sypher" class={linkState('/Axion/Personnel/sypher')}>
                        Sypher
                      </a>
                    </li>
                  </ul>
                </section>
              </div>

              <div class="db-content-column">
                {personnelColumns.right.map((level) => {
                  const group = personnelByAccessLevel.find((entry) => entry.level === level);
                  return group ? (
                    <section class="db-group" aria-label={`Personnel level ${level}`}>
                      <h3 class="db-section-title">Level {level}</h3>
                      <ul class="db-list db-sublist">
                        {group.members.map((person) => (
                          <li>
                            <a href={`/Axion/Personnel/${contentSlug(person.id)}`} class={linkState(`/Axion/Personnel/${contentSlug(person.id)}`)}>
                              {person.data.title}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </section>
                  ) : null;
                })}
              </div>
            </div>
          </div>
        </section>

        <section id="db-panel-entities" class="db-panel" role="tabpanel" aria-labelledby="db-tab-entities" hidden>
          <div class="card compact" aria-labelledby="sec-entities">
            <h2 id="sec-entities" class="db-title-blue">Entities</h2>
            <div class="db-content-grid">
              <div class="db-content-column">
                {entityGroups.left.map((group) => (
                  <section class="db-group" aria-label={group.title}>
                    <h3 class="db-section-title">{group.title}</h3>
                    <ul class="db-list db-sublist">
                      {group.entries.map((entry) => (
                        <li><a href={entry.href} class={linkState(entry.href)}>{entry.label}</a></li>
                      ))}
                    </ul>
                  </section>
                ))}
              </div>

              <div class="db-content-column">
                {entityGroups.right.map((group) => (
                  <section class="db-group" aria-label={group.title}>
                    <h3 class="db-section-title">{group.title}</h3>
                    {group.note && <p class="db-group-note">{group.note}</p>}
                    <ul class="db-list db-sublist">
                      {group.entries.map((entry) => (
                        <li><a href={entry.href} class={linkState(entry.href)}>{entry.label}</a></li>
                      ))}
                    </ul>
                  </section>
                ))}
              </div>
            </div>
          </div>
        </section>

        <section id="db-panel-containment" class="db-panel" role="tabpanel" aria-labelledby="db-tab-containment" hidden>
          <div class="card compact" aria-labelledby="sec-containment">
            <h2 id="sec-containment" class="db-title-cyan">Containment Classes</h2>
            <ul class="db-list">
              <li><a href="/Axion/Classes/a" class={linkState('/Axion/Classes/a')}>A - Ally</a></li>
              <li><a href="/Axion/Classes/s" class={linkState('/Axion/Classes/s')}>S - Safe </a></li>
              <li><a href="/Axion/Classes/c" class={linkState('/Axion/Classes/c')}>C - Containment </a></li>
              <li><a href="/Axion/Classes/m" class={linkState('/Axion/Classes/m')}>M - Maximum Containment </a></li>
            </ul>
          </div>
        </section>

        <section id="db-panel-levels" class="db-panel" role="tabpanel" aria-labelledby="db-tab-levels" hidden>
          <div class="card compact" aria-labelledby="sec-levels">
            <h2 id="sec-levels" class="db-title-pink">Levels</h2>
            <ul class="db-list">
              <li><a href="/Axion/Levels/0" class={linkState('/Axion/Levels/0')}>Level 0</a></li>
              <li><a href="/Axion/Levels/1" class={linkState('/Axion/Levels/1')}>Level 1</a></li>
              <li><a href="/Axion/Levels/2" class={linkState('/Axion/Levels/2')}>Level 2</a></li>
              <li><a href="/Axion/Levels/3" class={linkState('/Axion/Levels/3')}>Level 3</a></li>
              <li><a href="/Axion/Levels/4" class={linkState('/Axion/Levels/4')}>Level 4</a></li>
              <li><a href="/Axion/Levels/5" class={linkState('/Axion/Levels/5')}>Level 5</a></li>
            </ul>
          </div>
        </section>

        <section id="db-panel-articles" class="db-panel" role="tabpanel" aria-labelledby="db-tab-articles" hidden>
          <div class="card compact" aria-labelledby="sec-articles">
            <h2 id="sec-articles" class="db-title-blue">Articles</h2>
            <ul class="db-list">
              <li>
                <a href="/Axion/Articles/" class={linkState('/Axion/Articles/')}>Browse Archive</a>
                {publishedArticles.length > 0 && (
                  <ul class="db-list">
                    {publishedArticles.map((article) => (
                      <li>
                        <a href={`/Axion/Articles/${article.slug}`} class={linkState(`/Axion/Articles/${article.slug}`)}>
                          {article.data.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            </ul>
          </div>
        </section>
      </div>
    </div>
  </section>
</main>
<Footer></Footer>
