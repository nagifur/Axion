---
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');
const articleCategories = Array.from(new Set(
  articles.map((article) => article.data.category.trim()).filter(Boolean),
)).sort((first, second) => first.localeCompare(second));
---

<Header
  title="Submit a File"
  description="Build your own Axion Labs personnel, entity, or report file, preview it live, and export it ready to send in."
/>

<main id="main" tabindex="-1">
  <div class="page-stack submit-stack">
    <section class="card" role="article">
      <h1 id="submit-title">Submit a File <span class="cursor" aria-hidden="true"></span></h1>
      <p class="lead">
        Fill in the form below to build a Personnel, Entity, or Report file. The preview updates live so you can
        see exactly how your submission will look on the site. When you're happy with it, export the
        finished file and send it to me on Discord along with any images.
      </p>
      <p class="lead">
        Nothing here is uploaded automatically, this page only runs in your browser. Exporting just
        generates the files in correct format for you to send. 
      </p>
    </section>

    <section class="card submit-form-card" aria-labelledby="submit-form-title">
      <h2 id="submit-form-title" class="db-title-cyan">1. Build your file</h2>

      <div class="submit-type-toggle" role="radiogroup" aria-label="Submission type">
        <label class="submit-radio">
          <input type="radio" name="submit-type" value="personnel" checked /> Personnel
        </label>
        <label class="submit-radio">
          <input type="radio" name="submit-type" value="entity" /> Entity
        </label>
        <label class="submit-radio">
          <input type="radio" name="submit-type" value="article" /> Report
        </label>
      </div>

      <form id="submit-form" class="form-grid" autocomplete="off">
        <div class="form-field span-2">
          <label id="f-title-label" for="f-title">Name / Entity number</label>
          <input id="f-title" name="title" type="text" placeholder="e.g. Nagi or M-031" required />
        </div>

        <div class="form-field span-2">
          <label for="f-author">Author / Owner credit</label>
          <input id="f-author" name="author" type="text" placeholder="Optional — e.g. Your name or handle" />
        </div>

        <div class="form-field field-article span-2">
          <label for="f-description">Description</label>
          <input id="f-description" name="description" type="text" placeholder="A short summary shown in the report archive" />
        </div>
        <div class="form-field field-article category-field">
          <label for="f-category">Category</label>
          <div class="category-input-group">
            <input id="f-category" name="category" type="text" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="category-options" placeholder="Select or enter a new category" />
            <button type="button" id="category-browse" class="category-browse" aria-label="Browse existing categories" title="Browse existing categories"></button>
            <div id="category-options" class="category-options" role="listbox" hidden>
              {articleCategories.map((category) => (
                <button type="button" class="category-option" role="option" data-category={category}>{category}</button>
              ))}
            </div>
          </div>
        </div>

        <div class="form-field field-personnel">
          <label for="f-employeeID">Employee ID</label>
          <input id="f-employeeID" name="employeeID" type="text" placeholder="e.g. 5538" />
        </div>
        <div class="form-field field-personnel">
          <label for="f-position">Facility Position</label>
          <input id="f-position" name="position" type="text" placeholder="e.g. Caretaker" />
        </div>
        <div class="form-field field-personnel">
          <label for="f-accessLevel">Access Level</label>
          <select id="f-accessLevel" name="accessLevel">
            <option value="0">Level 0</option>
            <option value="1">Level 1</option>
            <option value="2">Level 2</option>
            <option value="3">Level 3</option>
            <option value="4">Level 4</option>
            <option value="5">Level 5</option>
          </select>
        </div>
        <div class="form-field field-personnel">
          <label for="f-height">Height</label>
          <input id="f-height" name="height" type="text" placeholder={"e.g. 5'7\" or {{5'7\"|1.70 m}}"} />
        </div>
        <div class="form-field field-personnel">
          <label for="f-birthplace">Birthplace</label>
          <input id="f-birthplace" name="birthplace" type="text" placeholder="e.g. Ventria" />
        </div>

        <div class="form-field field-entity">
          <label for="f-nickname">Nickname</label>
          <input id="f-nickname" name="nickname" type="text" placeholder="Optional" />
        </div>
        <div class="form-field field-entity">
          <label for="f-containmentClass">Containment Class</label>
          <select id="f-containmentClass" name="containmentClass">
            <option value="Ally">Ally (A)</option>
            <option value="Safe">Safe (S)</option>
            <option value="Containment">Containment (C)</option>
            <option value="Maximum Containment">Maximum Containment (M)</option>
            <option value="Unassigned">Unassigned (X)</option>
          </select>
        </div>
        <div class="form-field field-entity">
          <label for="f-type">Type</label>
          <input id="f-type" name="type" type="text" placeholder="e.g. Creature, Object, Phenomenon" />
        </div>
        <div class="form-field field-entity">
          <label for="f-foundOn">Found On</label>
          <input id="f-foundOn" name="foundOn" type="text" placeholder="e.g. Planet name" />
        </div>

        <div class="form-field field-profile">
          <label for="f-species">Species</label>
          <input id="f-species" name="species" type="text" />
        </div>
        <div class="form-field field-profile">
          <label for="f-gender">Gender</label>
          <input id="f-gender" name="gender" type="text" />
        </div>
        <div class="form-field field-profile">
          <label for="f-age">Age</label>
          <input id="f-age" name="age" type="text" placeholder="e.g. 25 or -Unknown-" />
        </div>
        <div class="form-field field-profile">
          <label for="f-vorePreference">Trophic Role</label>
          <select id="f-vorePreference" name="vorePreference">
            <option value="Prey">Prey</option>
            <option value="Predator">Predator</option>
            <option value="Switch">Switch</option>
            <option value="None">None</option>
          </select>
        </div>

        <div class="form-field field-personnel span-2">
          <label for="f-positiveTraits">Positive Traits (comma separated)</label>
          <input id="f-positiveTraits" name="positiveTraits" type="text" placeholder="Passionate, Friendly, Hardworking" />
        </div>
        <div class="form-field field-personnel span-2">
          <label for="f-negativeTraits">Negative Traits (comma separated)</label>
          <input id="f-negativeTraits" name="negativeTraits" type="text" placeholder="Clumsy, Slow" />
        </div>

        <div class="form-field field-entity span-2">
          <label for="f-usefulAbilities">Useful Abilities (comma separated)</label>
          <input id="f-usefulAbilities" name="usefulAbilities" type="text" placeholder="Shapeshifting, Flight" />
        </div>
        <div class="form-field field-entity span-2">
          <label for="f-noteableEvents">Noteable Events (comma separated)</label>
          <input id="f-noteableEvents" name="noteableEvents" type="text" placeholder="Escaped containment" />
        </div>

        <div class="form-field span-2">
          <label id="f-body-label" for="f-bio">Bio</label>
          <textarea id="f-bio" name="bio" rows="6" placeholder="Write the bio text here. Separate paragraphs with a blank line. You can use Markdown to format such as #, *, >, -"></textarea>
        </div>

        <div class="form-field field-article span-2">
          <div class="gallery-editor-head">
            <label>Inline Report Images</label>
            <button type="button" id="article-image-add" class="btn secondary">+ Add image</button>
          </div>
          <p class="field-hint article-image-hint">Add an image, choose its layout, then insert it at the current cursor position in the report body.</p>
          <div id="article-image-rows"></div>
        </div>

        <div class="form-field field-profile">
          <label class="submit-checkbox"><input id="f-patreon" type="checkbox" name="patreonSubmission" checked /> This is a Patreon submission</label>
        </div>

        <div class="form-field field-profile span-2">
          <label for="f-profile-image">Profile Image</label>
          <input id="f-profile-image" type="file" accept="image/*" />
          <p class="field-hint">Will be exported as <code>profile.&lt;ext&gt;</code>.</p>
        </div>

        <div class="form-field field-profile span-2">
          <div class="gallery-editor-head">
            <label>Gallery Images</label>
            <button type="button" id="gallery-add" class="btn secondary">+ Add image</button>
          </div>
          <div id="gallery-rows"></div>
        </div>
      </form>
    </section>

    <section class="card" aria-labelledby="preview-title">
      <h2 id="preview-title" class="db-title-cyan">2. Live Preview</h2>
      <div id="submit-preview"></div>
    </section>

    <section class="card" aria-labelledby="export-title">
      <h2 id="export-title" class="db-title-cyan">3. Export &amp; Send</h2>
      <p class="lead">
        Download your .zip and send it to me on Discord. The .zip contains the generated .md file and any images, already named and placed as the site expects.
      </p>
      <div class="article-body">
        <blockquote>
          <p class="lead">
            You can also download just the .md or copy its text to your clipboard. For submissions with images, rename them to match the list below.
          </p>
        </blockquote>
        
      </div>
      <div id="export-image-list" class="field-hint"></div>
      <div class="cta">
        <button type="button" id="export-download-zip" class="btn">Download .zip</button>
        <button type="button" id="export-download" class="btn secondary">Download .md</button>
        <button type="button" id="export-copy" class="btn secondary">Copy file text</button>
      </div>
      <pre id="export-output" class="export-output" aria-label="Generated file contents"></pre>
    </section>
  </div>
</main>

<Footer />

<script>
  import JSZip from 'jszip';

  type GalleryRow = { file: File | null; url: string | null; caption: string; filename: string };
  type ArticleImageAlignment = 'full' | 'center' | 'left' | 'right';
  type ArticleImageRow = {
    file: File | null;
    url: string | null;
    caption: string;
    alignment: ArticleImageAlignment;
    filename: string;
  };

  const form = document.getElementById('submit-form') as HTMLFormElement;
  const typeRadios = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="submit-type"]'));
  const previewEl = document.getElementById('submit-preview')!;
  const galleryRowsEl = document.getElementById('gallery-rows')!;
  const articleImageRowsEl = document.getElementById('article-image-rows')!;
  const exportOutput = document.getElementById('export-output')!;
  const exportImageList = document.getElementById('export-image-list')!;
  const profileImageInput = document.getElementById('f-profile-image') as HTMLInputElement;
  const titleLabel = document.getElementById('f-title-label')!;
  const titleInput = document.getElementById('f-title') as HTMLInputElement;
  const bodyLabel = document.getElementById('f-body-label')!;
  const bodyInput = document.getElementById('f-bio') as HTMLTextAreaElement;
  const categoryInput = document.getElementById('f-category') as HTMLInputElement;
  const categoryBrowse = document.getElementById('category-browse') as HTMLButtonElement;
  const categoryOptions = document.getElementById('category-options')!;
  const categoryOptionButtons = Array.from(categoryOptions.querySelectorAll<HTMLButtonElement>('.category-option'));

  let profileImageUrl: string | null = null;
  let profileImageFile: File | null = null;
  let profileImageExt = 'png';
  const galleryRows: GalleryRow[] = [];
  const articleImages: ArticleImageRow[] = [];
  let nextArticleImageNumber = 1;

  const currentType = () => typeRadios.find((radio) => radio.checked)?.value ?? 'personnel';

  const field = (name: string) => (form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null)?.value ?? '';

  // Show/hide fields specific to each submission type.
  const syncFieldVisibility = () => {
    const type = currentType();
    document.querySelectorAll<HTMLElement>('.field-personnel').forEach((el) => { el.hidden = type !== 'personnel'; });
    document.querySelectorAll<HTMLElement>('.field-entity').forEach((el) => { el.hidden = type !== 'entity'; });
    document.querySelectorAll<HTMLElement>('.field-article').forEach((el) => { el.hidden = type !== 'article'; });
    document.querySelectorAll<HTMLElement>('.field-profile').forEach((el) => { el.hidden = type === 'article'; });
    const isArticle = type === 'article';
    titleLabel.textContent = isArticle ? 'Report Title' : 'Name / Entity number';
    titleInput.placeholder = isArticle ? 'e.g. World info' : 'e.g. Nagi or M-031';
    bodyLabel.textContent = isArticle ? 'Report Body' : 'Bio';
    bodyInput.placeholder = isArticle
      ? 'Write the report here using Markdown. Separate paragraphs with a blank line.'
      : 'Write the bio text here. Separate paragraphs with a blank line. You can use Markdown to format such as #, *, >, -';
  };

  // Derive the file slug from the title — it always matches, so no separate field is needed.
  const slugify = (value: string) => value.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');

  // Strip "{{visible|tooltip}}" hover syntax down to the visible text for the preview.
  const plainText = (value: string) => value.replace(/\{\{([^|{}]*)\|[^{}]*\}\}/g, '$1');

  const csvList = (value: string) => value.split(',').map((item) => item.trim()).filter(Boolean);

  const escapeHtml = (value: string) => value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const escapeAttribute = (value: string) => escapeHtml(value).replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  const escapeDirectiveAttribute = (value: string) => value.replace(/\\/g, '\\\\').replace(/"/g, '\\"');

  const articleImageDirective = (row: ArticleImageRow) => {
    const caption = row.caption.trim();
    const alt = caption || row.filename;
    const folder = slugify(titleInput.value) || 'slug';
    return `::image{file="${row.filename}" folder="${folder}" alt="${escapeDirectiveAttribute(alt)}" caption="${escapeDirectiveAttribute(caption)}" align="${row.alignment}"}`;
  };

  const parseArticleImageDirective = (line: string) => {
    const match = line.match(/^::image\{(.+)\}$/);
    if (!match) return null;

    const attributes = new Map<string, string>();
    for (const attribute of match[1].matchAll(/\b(file|folder|alt|caption|align)="((?:\\.|[^"\\])*)"/g)) {
      attributes.set(attribute[1], attribute[2].replace(/\\(["\\])/g, '$1'));
    }

    const filename = attributes.get('file') ?? '';
    const row = articleImages.find((image) => image.filename === filename);
    const requestedAlignment = attributes.get('align');
    const alignment: ArticleImageAlignment = requestedAlignment === 'center' || requestedAlignment === 'left' || requestedAlignment === 'right'
      ? requestedAlignment
      : 'full';
    return {
      filename,
      url: row?.url ?? '',
      alt: attributes.get('alt') || attributes.get('caption') || filename,
      caption: attributes.get('caption') ?? '',
      alignment,
    };
  };

  // Inline markdown: **bold**, *italic*, `code`, [text](url).
  const renderInline = (value: string) => value
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/\*([^*]+)\*/g, '<em>$1</em>')
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>');

  // A small Markdown -> HTML converter covering the subset used across the site's bios (headings, quotes, lists, paragraphs).
  const renderMarkdown = (value: string) => {
    // Split on raw markdown syntax first, then escape each line's content — escaping upfront would
    // turn a leading ">" into "&gt;" and break the blockquote match below.
    const lines = plainText(value).split(/\r?\n/);
    let html = '';
    let inList = false;
    let paragraphLines: string[] = [];

    const flushParagraph = () => {
      if (paragraphLines.length) {
        html += `<p>${renderInline(paragraphLines.join(' '))}</p>`;
        paragraphLines = [];
      }
    };
    const closeList = () => { if (inList) { html += '</ul>'; inList = false; } };

    for (const line of lines) {
      const articleImage = parseArticleImageDirective(line.trim());
      const heading = line.match(/^(#{1,6})\s+(.*)$/);
      const quote = line.match(/^>\s?(.*)$/);
      const listItem = line.match(/^[-*]\s+(.*)$/);

      if (!line.trim()) { flushParagraph(); closeList(); continue; }
      if (articleImage) {
        flushParagraph(); closeList();
        const image = articleImage.url
          ? `<img src="${escapeAttribute(articleImage.url)}" alt="${escapeAttribute(articleImage.alt)}" />`
          : `<div class="article-image-missing">Image file: ${escapeHtml(articleImage.filename)}</div>`;
        html += `<figure class="article-image article-image--${articleImage.alignment}">${image}${articleImage.caption ? `<figcaption>${escapeHtml(articleImage.caption)}</figcaption>` : ''}</figure>`;
        continue;
      }
      if (heading) {
        flushParagraph(); closeList();
        const level = heading[1].length;
        html += `<h${level}>${renderInline(escapeHtml(heading[2]))}</h${level}>`;
        continue;
      }
      if (quote) {
        flushParagraph(); closeList();
        html += `<blockquote>${renderInline(escapeHtml(quote[1]))}</blockquote>`;
        continue;
      }
      if (listItem) {
        flushParagraph();
        if (!inList) { html += '<ul>'; inList = true; }
        html += `<li>${renderInline(escapeHtml(listItem[1]))}</li>`;
        continue;
      }
      closeList();
      paragraphLines.push(escapeHtml(line.trim()));
    }
    flushParagraph();
    closeList();
    return html;
  };

  const addGalleryRow = () => {
    const row: GalleryRow = { file: null, url: null, caption: '', filename: `${galleryRows.length + 1}.png` };
    galleryRows.push(row);
    appendGalleryRow(row);
    updatePreview();
  };

  const appendGalleryRow = (row: GalleryRow) => {
    const wrap = document.createElement('div');
    wrap.className = 'gallery-row';
    wrap.innerHTML = `
      <button type="button" class="btn secondary gallery-remove" data-role="remove" aria-label="Remove gallery image" title="Remove gallery image">X</button>
      <input type="file" accept="image/*" data-role="file" />
      <input type="text" data-role="caption" placeholder="Caption" value="${row.caption.replace(/"/g, '&quot;')}" />
      <span class="field-hint" data-role="filename">${row.filename}</span>
    `;

    const fileInput = wrap.querySelector('[data-role="file"]') as HTMLInputElement;
    const captionInput = wrap.querySelector('[data-role="caption"]') as HTMLInputElement;
    const filenameLabel = wrap.querySelector('[data-role="filename"]') as HTMLElement;
    const removeButton = wrap.querySelector('[data-role="remove"]') as HTMLButtonElement;

    fileInput.addEventListener('change', () => {
      const chosen = fileInput.files?.[0] ?? null;
      row.file = chosen;
      if (row.url) URL.revokeObjectURL(row.url);
      row.url = chosen ? URL.createObjectURL(chosen) : null;
      const ext = chosen?.name.split('.').pop()?.toLowerCase() || 'png';
      row.filename = `${galleryRows.indexOf(row) + 1}.${ext}`;
      filenameLabel.textContent = row.filename;
      updatePreview();
    });

    captionInput.addEventListener('input', () => {
      row.caption = captionInput.value;
      updatePreview();
    });

    removeButton.addEventListener('click', () => {
      const rowIndex = galleryRows.indexOf(row);
      if (rowIndex === -1) return;
      if (row.url) URL.revokeObjectURL(row.url);
      galleryRows.splice(rowIndex, 1);
      wrap.remove();
      galleryRows.forEach((remainingRow, i) => {
        const ext = remainingRow.filename.split('.').pop() || 'png';
        remainingRow.filename = `${i + 1}.${ext}`;
        const remainingWrap = galleryRowsEl.children[i];
        remainingWrap.querySelector('[data-role="filename"]')!.textContent = remainingRow.filename;
      });
      updatePreview();
    });

    galleryRowsEl.appendChild(wrap);
  };

  const syncArticleImageDirective = (row: ArticleImageRow, previousFilename = row.filename, remove = false) => {
    let changed = false;
    bodyInput.value = bodyInput.value.split(/\r?\n/).map((line) => {
      if (line.trim().startsWith('::image{') && line.includes(`file="${previousFilename}"`)) {
        changed = true;
        return remove ? '' : articleImageDirective(row);
      }
      return line;
    }).join('\n').replace(/\n{3,}/g, '\n\n');
    if (changed) bodyInput.dispatchEvent(new Event('input', { bubbles: true }));
  };

  const addArticleImageRow = () => {
    const row: ArticleImageRow = {
      file: null,
      url: null,
      caption: '',
      alignment: 'full',
      filename: `${nextArticleImageNumber++}.png`,
    };
    articleImages.push(row);

    const wrap = document.createElement('div');
    wrap.className = 'article-image-row';
    wrap.innerHTML = `
      <button type="button" class="btn secondary article-image-remove" aria-label="Remove report image" title="Remove report image">X</button>
      <div class="article-image-fields">
        <div class="article-image-file-line">
          <input type="file" accept="image/*" data-role="file" />
          <span class="field-hint" data-role="filename">${row.filename}</span>
        </div>
        <div class="article-image-meta">
          <input type="text" data-role="caption" placeholder="Caption" />
          <select data-role="alignment" aria-label="Image layout">
            <option value="full">Full width</option>
            <option value="center">Centered</option>
            <option value="left">Left</option>
            <option value="right">Right</option>
          </select>
          <button type="button" class="btn secondary" data-role="insert" disabled>Insert at cursor</button>
        </div>
      </div>
    `;

    const fileInput = wrap.querySelector('[data-role="file"]') as HTMLInputElement;
    const captionInput = wrap.querySelector('[data-role="caption"]') as HTMLInputElement;
    const alignmentSelect = wrap.querySelector('[data-role="alignment"]') as HTMLSelectElement;
    const filenameLabel = wrap.querySelector('[data-role="filename"]')!;
    const insertButton = wrap.querySelector('[data-role="insert"]') as HTMLButtonElement;
    const removeButton = wrap.querySelector('.article-image-remove') as HTMLButtonElement;

    fileInput.addEventListener('change', () => {
      const chosen = fileInput.files?.[0] ?? null;
      const previousFilename = row.filename;
      if (row.url) URL.revokeObjectURL(row.url);
      row.file = chosen;
      row.url = chosen ? URL.createObjectURL(chosen) : null;
      const extension = chosen?.name.split('.').pop()?.toLowerCase().replace(/[^a-z0-9]/g, '') || 'png';
      row.filename = `${row.filename.split('.')[0]}.${extension}`;
      filenameLabel.textContent = row.filename;
      insertButton.disabled = !chosen;
      syncArticleImageDirective(row, previousFilename);
      updatePreview();
    });

    captionInput.addEventListener('input', () => {
      row.caption = captionInput.value;
      syncArticleImageDirective(row);
      updatePreview();
    });
    alignmentSelect.addEventListener('change', () => {
      row.alignment = alignmentSelect.value as ArticleImageAlignment;
      syncArticleImageDirective(row);
      updatePreview();
    });
    insertButton.addEventListener('click', () => {
      const insertion = `\n\n${articleImageDirective(row)}\n\n`;
      bodyInput.setRangeText(insertion, bodyInput.selectionStart, bodyInput.selectionEnd, 'end');
      bodyInput.dispatchEvent(new Event('input', { bubbles: true }));
      bodyInput.focus();
    });
    removeButton.addEventListener('click', () => {
      if (row.url) URL.revokeObjectURL(row.url);
      syncArticleImageDirective(row, row.filename, true);
      articleImages.splice(articleImages.indexOf(row), 1);
      wrap.remove();
      updatePreview();
    });

    articleImageRowsEl.appendChild(wrap);
  };

  profileImageInput.addEventListener('change', () => {
    const chosen = profileImageInput.files?.[0] ?? null;
    if (profileImageUrl) URL.revokeObjectURL(profileImageUrl);
    profileImageFile = chosen;
    profileImageUrl = chosen ? URL.createObjectURL(chosen) : null;
    profileImageExt = chosen?.name.split('.').pop()?.toLowerCase() || 'png';
    updatePreview();
  });

  const setCategoryOpen = (open: boolean) => {
    categoryOptions.hidden = !open;
    categoryInput.setAttribute('aria-expanded', String(open));
  };

  const visibleCategoryOptions = () => categoryOptionButtons.filter((option) => !option.hidden);

  const filterCategoryOptions = () => {
    const query = categoryInput.value.trim().toLowerCase();
    categoryOptionButtons.forEach((option) => {
      option.hidden = Boolean(query) && !option.dataset.category!.toLowerCase().includes(query);
    });
    setCategoryOpen(visibleCategoryOptions().length > 0);
  };

  document.getElementById('gallery-add')!.addEventListener('click', addGalleryRow);
  document.getElementById('article-image-add')!.addEventListener('click', addArticleImageRow);
  titleInput.addEventListener('input', () => {
    if (currentType() === 'article') articleImages.forEach((row) => syncArticleImageDirective(row));
  });
  categoryBrowse.addEventListener('click', () => {
    const shouldOpen = categoryOptions.hidden;
    categoryOptionButtons.forEach((option) => { option.hidden = false; });
    setCategoryOpen(shouldOpen && categoryOptionButtons.length > 0);
    categoryInput.focus();
  });
  categoryInput.addEventListener('input', filterCategoryOptions);
  categoryInput.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setCategoryOpen(false);
    } else if (event.key === 'ArrowDown') {
      event.preventDefault();
      if (categoryOptions.hidden) filterCategoryOptions();
      visibleCategoryOptions()[0]?.focus();
    }
  });
  categoryOptionButtons.forEach((option) => {
    option.addEventListener('click', () => {
      categoryInput.value = option.dataset.category ?? '';
      categoryOptionButtons.forEach((item) => item.setAttribute('aria-selected', String(item === option)));
      categoryInput.dispatchEvent(new Event('input', { bubbles: true }));
      setCategoryOpen(false);
      categoryInput.focus();
    });
    option.addEventListener('keydown', (event) => {
      const options = visibleCategoryOptions();
      const index = options.indexOf(option);
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        options[(index + 1) % options.length]?.focus();
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        options[(index - 1 + options.length) % options.length]?.focus();
      } else if (event.key === 'Escape') {
        setCategoryOpen(false);
        categoryInput.focus();
      }
    });
  });
  document.addEventListener('click', (event) => {
    if (!categoryOptions.parentElement!.contains(event.target as Node)) setCategoryOpen(false);
  });
  typeRadios.forEach((radio) => radio.addEventListener('change', () => { syncFieldVisibility(); updatePreview(); }));
  form.addEventListener('input', updatePreview);

  // Build the preview markup, mirroring the real Personnel/Entities profile page layout.
  function renderPreview() {
    const type = currentType();
    const title = plainText(field('title')) || 'Title';
    const bioHtml = renderMarkdown(field('bio'));
    const author = plainText(field('author')).trim();

    if (type === 'article') {
      previewEl.innerHTML = `
        <article class="article-page">
          <header class="card article-header">
            <p class="article-meta">
              <span>${escapeHtml(plainText(field('category')) || 'Category')}</span>
            </p>
            <h1>${escapeHtml(title)} <span class="cursor" aria-hidden="true"></span></h1>
            <p class="article-description">${escapeHtml(plainText(field('description')) || 'Add a short report description.')}</p>
            ${author ? `<p class="article-byline">Filed by ${escapeHtml(author)}</p>` : ''}
          </header>
          <section class="card article-body">
            ${bioHtml || '<p class="field-hint">Write the report body to see it here.</p>'}
          </section>
        </article>
      `;
      return;
    }

    const galleryHtml = galleryRows.map((row) => `
      <figure>
        <img src="${row.url ?? ''}" alt="${title} — ${row.caption}" />
        <figcaption>${row.caption || '—'}</figcaption>
      </figure>
    `).join('') || '<p class="field-hint">No gallery images added yet.</p>';

    const statCell = (label: string, value: string) => `
      <div class="stat-cell">
        ${label}
        <span class="stat-value">${value || '—'}</span>
      </div>
    `;

    let statsHtml = '';
    let nicknameHtml = '';
    let traitsHtml = '';
    const authorHtml = author ? `<p class="profile-author">Submission by ${escapeHtml(author)}</p>` : '';

    if (type === 'personnel') {
      statsHtml = [
        statCell('Access Level', `Level ${plainText(field('accessLevel')) || '?'}`),
        statCell('Facility Position', plainText(field('position'))),
        statCell('Species', plainText(field('species'))),
        statCell('Gender', plainText(field('gender'))),
        statCell('Height', plainText(field('height'))),
        statCell('Age', plainText(field('age'))),
        statCell('Birthplace', plainText(field('birthplace'))),
        statCell('Trophic Role', plainText(field('vorePreference'))),
      ].join('');
      const positive = csvList(field('positiveTraits'));
      const negative = csvList(field('negativeTraits'));
      traitsHtml = `
        <div class="traits-grid">
          <div class="card" role="region"><h2 class="db-title-green">Positive Traits</h2>
            <ul class="trait-list positive">${positive.length ? positive.map((t) => `<li>${t}</li>`).join('') : '<li>None</li>'}</ul>
          </div>
          <div class="card" role="region"><h2 class="db-title-red">Negative Traits</h2>
            <ul class="trait-list negative">${negative.length ? negative.map((t) => `<li>${t}</li>`).join('') : '<li>None</li>'}</ul>
          </div>
        </div>
      `;
    } else {
      const nickname = plainText(field('nickname'));
      nicknameHtml = nickname ? `<p class="profile-nickname">"${nickname}"</p>` : '';
      statsHtml = [
        statCell('Containment Class', plainText(field('containmentClass'))),
        statCell('Type', plainText(field('type'))),
        statCell('Species', plainText(field('species'))),
        statCell('Gender', plainText(field('gender'))),
        statCell('Age', plainText(field('age'))),
        statCell('Found On', plainText(field('foundOn'))),
        statCell('Trophic Role', plainText(field('vorePreference'))),
      ].join('');
      const abilities = csvList(field('usefulAbilities'));
      const events = csvList(field('noteableEvents'));
      traitsHtml = `
        <div class="traits-grid">
          <div class="card" role="region"><h2 class="db-title-green">Useful Abilities</h2>
            <ul class="trait-list positive">${abilities.length ? abilities.map((t) => `<li>${t}</li>`).join('') : '<li>None</li>'}</ul>
          </div>
          <div class="card" role="region"><h2 class="db-title-red">Noteable Events</h2>
            <ul class="trait-list negative">${events.length ? events.map((t) => `<li>${t}</li>`).join('') : '<li>None</li>'}</ul>
          </div>
        </div>
      `;
    }

    previewEl.innerHTML = `
      <div class="card" role="article">
        <div class="profile-header">
          <h1 class="profile-name">${title}</h1>
          ${nicknameHtml}
          ${authorHtml}
        </div>
        <div class="profile">
          <div class="profile-media">
            <img class="pixelart-profile" src="${profileImageUrl ?? ''}"  />
          </div>
          <div class="stat-grid">${statsHtml}</div>
        </div>
      </div>
      <div class="card" role="region">
        <h2 class="db-title-cyan">Bio</h2>
        <div class="article-body">${bioHtml || '<p class="field-hint">Write a bio to see it here.</p>'}</div>
      </div>
      ${traitsHtml}
      <div class="card" role="region">
        <h2>Gallery</h2>
        <div class="gallery-grid">${galleryHtml}</div>
      </div>
    `;
  }

  // Build the frontmatter + bio text ready to hand off, and the checklist of image filenames to prepare.
  function buildFileText() {
    const type = currentType();
    const title = field('title').trim() || 'Untitled';
    const slug = slugify(title) || 'slug';
    const bio = field('bio').trim();
    const author = field('author').trim();
    const patreon = (document.getElementById('f-patreon') as HTMLInputElement).checked;
    const yamlList = (items: string[]) => `[${items.join(', ')}]`;
    const galleryYaml = galleryRows.length
      ? `\n${galleryRows.map((row) => `  - file: ${row.filename}\n    caption: ${row.caption || 'Caption'}`).join('\n')}`
      : ' []';

    let frontmatter = '';
    if (type === 'article') {
      frontmatter = [
        `title: ${JSON.stringify(title)}`,
        `description: ${JSON.stringify(field('description').trim() || 'Report description')}`,
        `category: ${JSON.stringify(field('category').trim() || 'Uncategorized')}`,
        ...(author ? [`author: ${JSON.stringify(author)}`] : []),
        `draft: false`,
      ].join('\n');
    } else if (type === 'personnel') {
      frontmatter = [
        `title: ${title}`,
        ...(author ? [`author: ${JSON.stringify(author)}`] : []),
        `employeeID: ${field('employeeID') || 'None'}`,
        `position: ${field('position') || 'None'}`,
        `species: ${field('species') || 'None'}`,
        `gender: ${field('gender') || 'None'}`,
        `height: "${field('height') || 'None'}"`,
        `age: ${field('age') || 'None'}`,
        `accessLevel: ${field('accessLevel') || 1}`,
        `birthplace: ${field('birthplace') || 'None'}`,
        `profileImage: profile.${profileImageExt}`,
        `galleryAlt: ${title} drawing`,
        `positiveTraits: ${yamlList(csvList(field('positiveTraits')))}`,
        `negativeTraits: ${yamlList(csvList(field('negativeTraits')))}`,
        `vorePreference: ${yamlList([field('vorePreference') || 'None'])}`,
        `draft: false`,
        `patreonSubmission: ${patreon}`,
        `gallery:${galleryYaml}`,
      ].join('\n');
    } else {
      frontmatter = [
        `title: ${title}`,
        ...(author ? [`author: ${JSON.stringify(author)}`] : []),
        `nickname: ${field('nickname') || 'None'}`,
        `containmentClass: ${field('containmentClass') || 'None'}`,
        `type: ${field('type') || 'None'}`,
        `species: ${field('species') || 'None'}`,
        `gender: ${field('gender') || 'None'}`,
        `age: ${field('age') || 'None'}`,
        `foundOn: ${field('foundOn') || 'None'}`,
        `profileImage: profile.${profileImageExt}`,
        `galleryAlt: ${title} drawing`,
        `usefulAbilities: ${yamlList(csvList(field('usefulAbilities')))}`,
        `noteableEvents: ${yamlList(csvList(field('noteableEvents')))}`,
        `vorePreference: ${yamlList([field('vorePreference') || 'None'])}`,
        `draft: false`,
        `patreonSubmission: ${patreon}`,
        `gallery:${galleryYaml}`,
      ].join('\n');
    }

    const fileText = `---\n${frontmatter}\n---\n\n${bio || (type === 'article' ? 'Write the report here.' : 'Write the bio here.')}\n`;
    const imageChecklist = type === 'article'
      ? articleImages.filter((row) => row.file).map((row) => `${row.filename} (${row.caption || 'report image'})`)
      : [`profile.${profileImageExt} (profile image)`, ...galleryRows.map((row) => `${row.filename} (${row.caption || 'no caption'})`)];

    return { slug, fileText, imageChecklist };
  }

  function updateExport() {
    const { fileText, imageChecklist } = buildFileText();
    exportOutput.textContent = fileText;
    exportImageList.innerHTML = imageChecklist.length
      ? `<strong>Included image files:</strong> ${imageChecklist.join(', ')}`
      : '<strong>No images included.</strong>';
  }

  function updatePreview() {
    renderPreview();
    updateExport();
  }

  document.getElementById('export-copy')!.addEventListener('click', async () => {
    await navigator.clipboard.writeText(exportOutput.textContent ?? '');
  });

  document.getElementById('export-download')!.addEventListener('click', () => {
    const { slug, fileText } = buildFileText();
    const blob = new Blob([fileText], { type: 'text/markdown' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `${slug || 'submission'}.md`;
    link.click();
    URL.revokeObjectURL(url);
  });

  // Bundle the generated .md alongside the actual uploaded images, already named/placed as the site expects.
  document.getElementById('export-download-zip')!.addEventListener('click', async () => {
    const { slug, fileText } = buildFileText();
    const type = currentType();
    const folder = slug || 'submission';
    const zip = new JSZip();
    if (type === 'article') {
      zip.file(`src/content/articles/${folder}.md`, fileText);
      articleImages.forEach((row) => {
        if (row.file) zip.file(`public/images/articles/${folder}/${row.filename}`, row.file);
      });
    } else {
      zip.file(`${folder}.md`, fileText);
      if (profileImageFile) zip.file(`${folder}/profile.${profileImageExt}`, profileImageFile);
      galleryRows.forEach((row) => {
        if (row.file) zip.file(`${folder}/${row.filename}`, row.file);
      });
    }

    const blob = await zip.generateAsync({ type: 'blob' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `${folder}.zip`;
    link.click();
    URL.revokeObjectURL(url);
  });

  syncFieldVisibility();
  updatePreview();
</script>
