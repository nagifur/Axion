---
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { toSimCharacter, toSimImpostor, type SimCharacter, type SimImpostor } from '../lib/sim/roster';
import type { MonitorConfig } from '../lib/sim/monitor';
import { loadRoom } from '../lib/sim/roomLoader';
import characterSheet from '../sim_assets/characters/char_spritesheet.png';

// Folder in src/sim_assets/rooms/ shown on this camera.
const ROOM_ID = 'level-1-offices';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

type ImageModule = { default: ImageMetadata };
const fileStem = (path: string) => path.split('/').pop()!.replace(/\.[^.]+$/, '');

const profileImages = import.meta.glob<ImageModule>(
  '../assets/images/*/*.{png,jpg,jpeg,webp,gif}',
  { eager: true },
);
const roomImages = import.meta.glob<ImageModule>('../sim_assets/rooms/*/room.png', { eager: true });
const propImages = import.meta.glob<ImageModule>('../sim_assets/props/*.png', { eager: true });

const room = await loadRoom(ROOM_ID);
const roomImage = roomImages[`../sim_assets/rooms/${ROOM_ID}/room.png`]?.default;
if (!roomImage) throw new Error(`Missing src/sim_assets/rooms/${ROOM_ID}/room.png`);

// Small thumbnails for the file panel, matched like profile pages do (same name, any extension).
async function thumbnail(folder: string, file: string) {
  const stem = file.replace(/\.[^.]+$/, '');
  const match = Object.entries(profileImages).find(([path]) => {
    const [dir, name] = path.split('/').slice(-2);
    return dir === folder && name.replace(/\.[^.]+$/, '') === stem;
  });
  if (!match) return undefined;
  const image = await getImage({ src: match[1].default, width: 144, height: 144, format: 'webp' });
  return image.src;
}

const personnel = await getCollection('personnel', ({ data }) => !data.draft);
const entities = await getCollection('entities', ({ data }) => !data.draft);

const roster = (await Promise.all(personnel.map(async (entry) => {
  const id = entry.id.replace(/\.md$/, '');
  return toSimCharacter(entry, base, await thumbnail(id, entry.data.profileImage));
}))).filter((character): character is SimCharacter => character !== null);

const impostors = (await Promise.all(entities.map(async (entry) => {
  const id = entry.id.replace(/\.md$/, '');
  return toSimImpostor(entry, base, await thumbnail(id, entry.data.profileImage));
}))).filter((impostor): impostor is SimImpostor => impostor !== null);

const config: MonitorConfig = {
  roster,
  impostors,
  room,
  assets: {
    room: roomImage.src,
    character: characterSheet.src,
    ...Object.fromEntries(Object.entries(propImages).map(([path, image]) => [fileStem(path), image.default.src])),
  },
};
// Escape "<" so profile text can never close the inline JSON script.
const configJson = JSON.stringify(config).replace(/</g, '\\u003c');
---
<Header
  title="Live Monitoring"
  description="Live security camera feed from the Axion Labs facility. Watch personnel go about their shift."
/>

<main id="main" tabindex="-1">
  <nav class="article-return-top" aria-label="Site navigation">
    <a href={`${base}/`}>
      <span class="article-return-arrow" aria-hidden="true">←</span>
      <span>Back</span>
    </a>
  </nav>

  <article class="monitor-page" data-monitor>
    <script type="application/json" is:inline data-monitor-config set:html={configJson}></script>

    <header class="card article-header">
      <h1>Live Monitoring <span class="cursor" aria-hidden="true"></span></h1>
      <p>
        Monitoring sector relay of the Level {room.level} security cameras. Select anyone on the feed to pull up
        their database file. Report anything unusual. All activity on this feed is logged by A1.
      </p>
    </header>

    <section class="card monitor-feed" aria-labelledby="monitor-feed-title">
      <div class="monitor-hud">
        <span class="monitor-rec"><span class="monitor-rec-dot" aria-hidden="true"></span>Rec</span>
        <h2 id="monitor-feed-title" class="monitor-cam">{room.camera} · Level {room.level} · {room.name}</h2>
        <span class="monitor-alert" data-monitor-alert>All clear</span>
        <time class="monitor-clock" data-monitor-clock>--:--:--</time>
      </div>

      <div class="monitor-screen">
        <canvas
          data-monitor-canvas
          width={room.width}
          height={room.height}
          style={`aspect-ratio:${room.width} / ${room.height}`}
          role="img"
          aria-label={`Live camera feed of the Level ${room.level} ${room.name.toLowerCase()}. Use the name tags to open personnel files.`}
        ></canvas>
        <div class="monitor-tags" data-monitor-tags></div>
        <div class="monitor-crt" aria-hidden="true"></div>
        <p class="monitor-status" data-monitor-status>Connecting to feed…</p>
        <noscript><p class="monitor-status">Feed requires JavaScript</p></noscript>
        <p class="monitor-toast" data-monitor-toast role="status" hidden></p>
      </div>

      <div class="monitor-controls">
        <button type="button" class="btn secondary" data-monitor-toggle-tags aria-pressed="true">Name tags: On</button>
        <button type="button" class="btn secondary" data-monitor-toggle-pause aria-pressed="false">Pause feed</button>
        <div class="monitor-debug" data-monitor-debug hidden>
          <span class="monitor-debug-label">Debug</span>
          <button type="button" class="btn" data-debug="impostor">Impostor</button>
          <button type="button" class="btn" data-debug="arrive">Arrival</button>
          <button type="button" class="btn" data-debug="nap">Nap</button>
          <button type="button" class="btn" data-debug="trip">Trip</button>
          <button type="button" class="btn" data-debug="announce">A1 message</button>
          <button type="button" class="btn" data-debug="speed">Speed ×4</button>
          <button type="button" class="btn danger" data-debug="reset">Reset progress</button>
        </div>
      </div>
    </section>

    <div class="monitor-panels">
      <section class="card monitor-file" data-monitor-file aria-label="Selected personnel file"></section>

      <section class="card monitor-log-card" aria-labelledby="monitor-log-title">
        <div class="panel-kicker">
          <span id="monitor-log-title">Incident log</span>
          <span class="panel-kicker-meta">A1 relay</span>
        </div>
        <ol class="monitor-log" data-monitor-log></ol>
      </section>

      <section class="card monitor-directives" aria-labelledby="monitor-directives-title">
        <div class="panel-kicker">
          <span id="monitor-directives-title">Directives</span>
          <span class="panel-kicker-meta" data-monitor-achievement-count></span>
        </div>
        <p class="monitor-roster">Personnel identified: <strong data-monitor-roster-count></strong></p>
        <ul class="monitor-achievements" data-monitor-achievements></ul>
      </section>
    </div>
  </article>
</main>

<Footer />

<script>
  import { initMonitor } from '../lib/sim/monitor';

  // The site uses view transitions, so start on every page load and stop before leaving.
  let cleanup: (() => void) | undefined;
  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    const root = document.querySelector<HTMLElement>('[data-monitor]');
    cleanup = root ? initMonitor(root) : undefined;
  });
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>

<style is:global>
  /* Global because tags, log lines and file contents are created at runtime. */
  .monitor-page{ width:100%; max-width:1180px; display:flex; flex-direction:column; gap:16px }
  .monitor-feed{ display:flex; flex-direction:column; gap:12px }

  .monitor-hud{
    display:flex; align-items:center; flex-wrap:wrap; gap:6px 16px;
    font-size:0.7rem; letter-spacing:0.14em; text-transform:uppercase; color:var(--muted);
  }
  .monitor-cam{ flex:1; margin:0; font-size:0.78rem; letter-spacing:0.14em; color:var(--neon-cyan) }
  .monitor-rec{ display:inline-flex; align-items:center; gap:6px; color:var(--neon-red) }
  .monitor-rec-dot{ width:8px; height:8px; border-radius:50%; background:currentColor; animation:monitor-blink 1.4s steps(2, jump-none) infinite }
  .monitor-alert{ color:var(--neon-green) }
  .monitor-alert.is-alert{ color:var(--neon-red); animation:monitor-blink 0.9s steps(2, jump-none) infinite }
  .monitor-clock{ color:var(--text); font-variant-numeric:tabular-nums }
  body.animations-off :is(.monitor-rec-dot, .monitor-alert){ animation:none }
  @keyframes monitor-blink{ 50%{ opacity:0.25 } }

  .monitor-screen{
    position:relative; overflow:hidden;
    background:#05080d; border:2px solid var(--line-soft); border-radius:var(--radius-sm);
  }
  .monitor-screen canvas{
    display:block; width:100%; height:auto;
    image-rendering:pixelated; touch-action:manipulation;
  }
  .monitor-crt{
    position:absolute; inset:0; pointer-events:none;
    background:
      repeating-linear-gradient(to bottom, transparent 0 2px, rgba(0, 0, 0, 0.16) 2px 3px),
      radial-gradient(ellipse at center, transparent 62%, rgba(0, 0, 0, 0.5) 100%);
  }
  .monitor-status{
    position:absolute; inset:0; display:grid; place-items:center; margin:0;
    background:#05080d; color:var(--neon-red); letter-spacing:0.24em; text-transform:uppercase; font-size:0.8rem;
  }
  .monitor-status[hidden]{ display:none }
  .monitor-toast{
    position:absolute; left:50%; bottom:10px; transform:translateX(-50%); margin:0; padding:6px 12px;
    background:rgba(5, 8, 13, 0.9); border:1px solid var(--neon-green); color:var(--neon-green);
    font-size:0.72rem; letter-spacing:0.1em; text-transform:uppercase; white-space:nowrap; pointer-events:none;
  }
  .monitor-page.is-paused .monitor-screen::after{
    content:'Paused'; position:absolute; top:10px; right:12px; padding:2px 8px;
    background:rgba(5, 8, 13, 0.85); color:var(--neon-yellow); font-size:0.7rem; letter-spacing:0.2em; text-transform:uppercase;
  }

  .monitor-tags{ position:absolute; inset:0; pointer-events:none }
  .monitor-tag{
    position:absolute; transform:translate(-50%, -100%);
    display:flex; flex-direction:column; align-items:center; gap:2px;
    padding:0 2px; border:0; background:none; cursor:pointer; pointer-events:auto;
    font:inherit; font-size:clamp(0.48rem, 1.05vw, 0.66rem); line-height:1.15; white-space:nowrap;
    color:var(--tag-tint, var(--neon-cyan));
  }
  .monitor-tag[hidden]{ display:none }
  .monitor-tag-name{
    padding:1px 5px; border-radius:2px; letter-spacing:0.08em; text-transform:uppercase;
    background:rgba(5, 8, 13, 0.78); border:1px solid color-mix(in srgb, var(--tag-tint, #7ef5ff) 55%, transparent);
    transition:opacity 0.15s ease;
  }
  .monitor-tag-bubble{ padding:0 4px; border-radius:2px; background:rgba(5, 8, 13, 0.78); color:#fff; font-weight:700 }
  .monitor-tag-bubble:empty{ display:none }
  .monitor-tag.is-active .monitor-tag-name{ color:#fff; background:color-mix(in srgb, var(--tag-tint, #7ef5ff) 35%, #05080d) }
  .monitor-tag.is-quiet .monitor-tag-name{ opacity:0 }
  .monitor-tag:focus-visible{ outline:none }
  .monitor-tag:focus-visible .monitor-tag-name{ opacity:1; outline:2px solid var(--neon-cyan); outline-offset:1px }

  .monitor-controls{ display:flex; flex-wrap:wrap; align-items:center; gap:8px }
  .monitor-debug{ display:flex; flex-wrap:wrap; align-items:center; gap:6px; margin-left:auto }
  .monitor-debug[hidden]{ display:none }
  .monitor-debug-label{ font-size:0.68rem; letter-spacing:0.16em; text-transform:uppercase; color:var(--neon-yellow) }

  .monitor-panels{ display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:16px; align-items:start }

  .monitor-file{ --file-tint:var(--neon-cyan); display:flex; flex-direction:column; gap:12px }
  .monitor-file-empty{ margin:0; color:var(--muted) }
  .monitor-file-head{ display:flex; gap:12px; align-items:center }
  .monitor-file-photo{ width:72px; height:72px; object-fit:cover; border:2px solid var(--file-tint); border-radius:var(--radius-sm); background:#05080d }
  .monitor-file-title h3{ margin:2px 0 0; color:var(--file-tint) }
  .monitor-file-title .panel-kicker{ margin:0 }
  .monitor-file-role{ margin:2px 0 0; color:var(--muted); font-size:0.85rem }
  .monitor-file-stats{ display:grid; gap:4px; margin:0 }
  .monitor-file-stats > div{ display:flex; justify-content:space-between; gap:12px; padding:4px 8px; background:var(--stat-cell); border-radius:var(--radius-sm) }
  .monitor-file-stats dt{ color:var(--muted); font-size:0.75rem; letter-spacing:0.08em; text-transform:uppercase }
  .monitor-file-stats dd{ margin:0; text-align:right }
  .monitor-file-warning{ margin:0; padding:6px 8px; border:1px solid var(--neon-red); color:var(--neon-red); font-size:0.8rem }
  .monitor-file-traits{ display:flex; flex-wrap:wrap; gap:6px; margin:0; padding:0; list-style:none }
  .monitor-file-traits li{ padding:2px 8px; border:1px solid var(--line-soft); border-radius:var(--radius-pill); font-size:0.72rem }
  .monitor-file-link{ align-self:flex-start }

  .monitor-log{ display:flex; flex-direction:column; gap:4px; max-height:320px; overflow:auto; margin:8px 0 0; padding:0; list-style:none; font-size:0.78rem }
  .monitor-log-line{ display:flex; gap:8px; line-height:1.35 }
  .monitor-log-time{ flex:none; color:var(--muted); font-variant-numeric:tabular-nums }
  .monitor-log-line.is-muted{ color:var(--muted) }
  .monitor-log-line.is-ok{ color:var(--neon-green) }
  .monitor-log-line.is-warn{ color:var(--neon-yellow) }
  .monitor-log-line.is-alert{ color:var(--neon-red) }

  .monitor-roster{ margin:8px 0; font-size:0.85rem; color:var(--muted) }
  .monitor-roster strong{ color:var(--text) }
  .monitor-achievements{ display:flex; flex-direction:column; gap:8px; margin:0; padding:0; list-style:none }
  .monitor-achievement{ display:grid; grid-template-columns:auto 1fr; gap:0 8px; color:var(--muted); font-size:0.8rem }
  .monitor-achievement-mark{ grid-row:span 2; color:var(--line-soft) }
  .monitor-achievement-title{ color:var(--text) }
  .monitor-achievement:not(.is-unlocked) .monitor-achievement-title{ opacity:0.6 }
  .monitor-achievement.is-unlocked .monitor-achievement-mark{ color:var(--neon-green) }
</style>
