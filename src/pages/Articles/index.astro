---
import Header from '../../components/header.astro';
import Footer from '../../components/footer.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles', ({ data }) => !data.draft);

const articleBase = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/Articles`;
---

<Header
  title="Report Archive"
  description="Research notes, field reports, incident records, and facility notices."
/>

<main id="main" tabindex="-1">
  <section class="card article-archive" aria-labelledby="archive-title">
    <h1 id="archive-title">Report Archive <span class="cursor" aria-hidden="true"></span></h1>
    <p class="lead">Research notes, field reports, incident records, and facility notices.</p>

    {articles.length > 0 ? (
      <ol class="article-list">
        {articles.map((article) => (
          <li>
            <article class="article-preview">
              <p class="article-meta">
                <span>{article.data.category}</span>
              </p>
              <h2><a href={`${articleBase}/${article.slug}`}>{article.data.title}</a></h2>
              <p>{article.data.description}</p>
              {article.data.author && <p class="article-byline">Filed by {article.data.author}</p>}
            </article>
          </li>
        ))}
      </ol>
    ) : (
      <p class="article-empty">No published reports are currently available.</p>
    )}
  </section>

  <nav class="article-return" aria-label="Database navigation">
    <a href="/database">← Back to Database</a>
  </nav>
</main>

<Footer />