---
import Header from '../../components/header.astro';
import Footer from '../../components/footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);

  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const articleBase = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/Articles`;
const formatDate = (date: Date) => date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Header
  title={article.data.title}
  description={article.data.description}
  type="article"
/>

<main
  id="main"
  class="profile-page"
  tabindex="-1"
  style={`--profile-tint: ${article.data.colorTint ?? 'var(--neon-cyan)'}`}
>
  <nav class="article-return-top" aria-label="Database navigation">
    <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/database`}>
      <span class="article-return-arrow" aria-hidden="true">←</span>
      <span>Back</span>
    </a>
  </nav>
  <article class="article-page">
    <header class="card article-header">
      <div class="profile-header">
        {article.data.patreonSubmission && (
          <span class="patreon-indicator" title="Patreon submission">
            <span class="patreon-indicator-light" aria-hidden="true"></span>
            Patreon submission
          </span>
        )}
        <p class="article-meta">
          <span>{article.data.category}</span>
        </p>
        <h1 class="profile-name">{article.data.title} <span class="cursor" aria-hidden="true"></span></h1>
        <p class="article-description">{article.data.description}</p>
        {article.data.author && <p class="article-byline">Filed by {article.data.author}</p>}
        {article.data.updatedAt && <p class="article-updated">Last updated {formatDate(article.data.updatedAt)}</p>}
      </div>
    </header>

    <section class="card article-body">
      <Content />
    </section>

    
  </article>
</main>

<Footer />