---
import Header from '../../components/header.astro';
import Footer from '../../components/footer.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('entities', ({ data }) => !data.draft);

  return entries.map((entry) => {
    const slug = entry.id.replace(/\.md$/, '');

    return {
      params: { slug },
      props: { entry, slug },
    };
  });
}

const { entry, slug } = Astro.props;
const { Content } = await render(entry);
const { data: entity } = entry;

// Load every image asset from the assets/images folder and index them by "slug/filename".
const galleryImages = Object.fromEntries(
  Object.entries(import.meta.glob('../../assets/images/*/*', { eager: true }) as Record<string, any>)
    .map(([path, mod]: [string, any]) => {
      const normalizedPath = path.replaceAll('\\', '/');
      const segments = normalizedPath.split('/');
      const key = segments.slice(-2).join('/');
      const value = (mod && typeof mod === 'object' && 'default' in mod) ? mod.default : mod;
      return [key, value];
    }),
) as Record<string, any>;
const base = (Astro as any).base ?? import.meta.env.BASE_URL ?? '';
const placeholderImage = `${base}/placeholder.png`;
const entitiesBase = `${base}/Entities`;
const personnelBase = `${base}/Personnel`;

// Look up a gallery image by slug and filename.
// If the exact filename is not found, fall back to the same basename with any supported extension.
const getGalleryImage = (slug: string, filename: string) => {
  const exactKey = `${slug}/${filename}`;
  if (exactKey in galleryImages) {
    return galleryImages[exactKey];
  }

  const basename = filename.replace(/\.[^/.]+$/, '');
  const fallbackKey = Object.keys(galleryImages).find((key) => {
    return key.startsWith(`${slug}/`) && key.replace(/^[^/]+\//, '').replace(/\.[^/.]+$/, '') === basename;
  });

  return fallbackKey ? galleryImages[fallbackKey] : undefined;
};

// Use the helper to resolve the profile image, including extension fallback.
const profileImport = getGalleryImage(slug, entity.profileImage) ?? placeholderImage;
// Detect animated GIFs so we can render them with a native <img> tag and preserve animation.
const profileIsGif = /\.gif$/i.test(entity.profileImage);
const profileIsPlaceholder = profileImport === placeholderImage;
---

<Header />

<main>
  <div class="page-stack">
    <section class="card" role="article">
      <h1>{entity.title} - <div style="font-size: 1.25rem; font-weight: bold;">{entity.nickname}</div> <span class="cursor" aria-hidden="true"></span></h1>
      <div class="profile">
        {profileIsGif || profileIsPlaceholder ? (
          <img src={profileImport} class="pixelart-profile" alt={`Profile image of ${entity.title}`} loading="lazy" />
        ) : (
          <Image src={profileImport} class="pixelart-profile" quality={100} alt={`Profile image of ${entity.title}`} />
        )}

        <dl class="info-dl">
          <div>
            <dt>Containment Class</dt>
            <dd>{entity.containmentClass}</dd>
          </div>
          <div>
            <dt>Type </dt>
            <dd>{entity.type}</dd>
          </div>
          <div>
            <dt>Species</dt>
            <dd>{entity.species}</dd>
          </div>
          <div>
            <dt>Gender</dt>
            <dd>{entity.gender}</dd>
          </div>
          <div>
            <dt>Age</dt>
            <dd>{entity.age}</dd>
          </div>
          <div>
            <dt>Found On</dt>
            <dd>{entity.foundOn}</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="card" role="region" aria-labelledby="bio-title">
      <h2 id="bio-title" class="db-title-cyan">Bio</h2>
      <div class="article-body">
        <Content />
      </div>
    </section>

    <section class="traits-grid" aria-label="Traits">
      <div class="card" role="region" aria-labelledby="pos-title">
        <h2 id="pos-title" class="db-title-yellow">Useful Abilities</h2>
        <ul class="trait-list positive">
          {entity.usefulAbilities.length ? entity.usefulAbilities.map((trait) => (
            <li>{trait}</li>
          )) : <li>None</li>}
        </ul>
      </div>
      <div class="card" role="region" aria-labelledby="neg-title">
        <h2 id="neg-title" class="db-title-pink">Noteable Events</h2>
        <ul class="trait-list negative">
          {entity.noteableEvents.length ? entity.noteableEvents.map((trait) => (
            <li>{trait}</li>
          )) : <li>None</li>}
        </ul>
      </div>
    </section>

    <section class="card" role="region" aria-labelledby="gallery-title">
      <h2 id="gallery-title">Gallery</h2>
      <div class="gallery-grid">
        {entity.gallery.map((item) => {
          const imageSrc = getGalleryImage(slug, item.file) ?? placeholderImage;
          const isGif = /\.gif$/i.test(item.file);
          const isPlaceholder = imageSrc === placeholderImage;
          return (
            <figure>
              {isGif ? (
                <img src={imageSrc} class="pixelart" alt={entity.galleryAlt} loading="lazy" />
              ) : isPlaceholder ? (
                <img src={imageSrc} class="pixelart" alt={entity.galleryAlt} loading="lazy" />
              ) : (
                <Image src={imageSrc} class="pixelart" alt={entity.galleryAlt} loading="lazy" />
              )}
              <figcaption>{item.caption}</figcaption>
            </figure>
          );
        })}
      </div>
    </section>
  </div>
</main>

<!-- Lightbox modal for gallery images -->
<div id="lightbox" class="lightbox-overlay" role="dialog" aria-modal="true" hidden tabindex="-1">
  <div class="lightbox-content">
    <button id="lightbox-close" class="lightbox-close" aria-label="Close image">×</button>
    <img class="lightbox-img" alt="Expanded image" />
  </div>
</div>

<Footer />
