---
import Header from '../../components/header.astro';
import Footer from '../../components/footer.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import HoverText from '../../components/HoverText.astro';
import StatIcon from '../../components/StatIcon.astro';

export async function getStaticPaths() {
  const entries = await getCollection('entities', ({ data }) => !data.draft);

  return entries.map((entry) => {
    const slug = entry.id.replace(/\.md$/, '');

    return {
      params: { slug },
      props: { entry, slug },
    };
  });
}

const { entry, slug } = Astro.props;
const { Content } = await render(entry);
const { data: entity } = entry;

// Load every image asset from the assets/images folder and index them by "slug/filename".
const galleryImages = Object.fromEntries(
  Object.entries(import.meta.glob('../../assets/images/*/*', { eager: true }) as Record<string, any>)
    .map(([path, mod]: [string, any]) => {
      const normalizedPath = path.replaceAll('\\', '/');
      const segments = normalizedPath.split('/');
      const key = segments.slice(-2).join('/');
      const value = (mod && typeof mod === 'object' && 'default' in mod) ? mod.default : mod;
      return [key, value];
    }),
) as Record<string, any>;
const base = ((Astro as any).base ?? import.meta.env.BASE_URL ?? '').replace(/\/$/, '');
const placeholderImage = `${base}/placeholder.png`;
const entitiesBase = `${base}/Entities`;
const personnelBase = `${base}/Personnel`;
// Link the containment class stat to its Classes page when the label matches a known class.
const containmentClassSlugByLabel: Record<string, string> = {
  Ally: 'a',
  Safe: 's',
  Containment: 'c',
  'Maximum Containment': 'm',
};
const containmentClassHref = containmentClassSlugByLabel[entity.containmentClass]
  ? `${base}/Classes/${containmentClassSlugByLabel[entity.containmentClass]}`
  : undefined;

// Look up a gallery image by slug and filename.
// If the exact filename is not found, fall back to the same basename with any supported extension.
const getGalleryImage = (slug: string, filename: string) => {
  const exactKey = `${slug}/${filename}`;
  if (exactKey in galleryImages) {
    return galleryImages[exactKey];
  }

  const basename = filename.replace(/\.[^/.]+$/, '');
  const fallbackKey = Object.keys(galleryImages).find((key) => {
    return key.startsWith(`${slug}/`) && key.replace(/^[^/]+\//, '').replace(/\.[^/.]+$/, '') === basename;
  });

  return fallbackKey ? galleryImages[fallbackKey] : undefined;
};

// Use the helper to resolve the profile image, including extension fallback.
const profileImport = getGalleryImage(slug, entity.profileImage) ?? placeholderImage;
const profileNativeSrc = typeof profileImport === 'string' ? profileImport : profileImport.src;
// Detect animated GIFs so we can render them with a native <img> tag and preserve animation.
const profileIsGif = /\.gif$/i.test(entity.profileImage);
const profileIsPlaceholder = profileImport === placeholderImage;
---

<Header
  title={entity.title}
  description={`${entity.containmentClass} | ${entity.type} | Axion Labs entity file`}
  image={`${base}/Entities/${slug}/og.png?v=2`}
  imageAlt={`Database card for ${entity.title}`}
  type="profile"
/>

<main
  id="main"
  class="profile-page"
  tabindex="-1"
  style={`--profile-tint: ${entity.colorTint ?? 'var(--neon-cyan)'}`}
>
  <nav class="article-return-top" aria-label="Database navigation">
    <a href={`${base}/database`}>
      <span class="article-return-arrow" aria-hidden="true">←</span>
      <span>Back</span>
    </a>
  </nav>
  <div class="page-stack">
    <section class="card" role="article">
      <div class="profile-header">
        <h1 class="profile-name">{entity.title}<span class="cursor" aria-hidden="true"></span></h1>
        {entity.nickname && <p class="profile-nickname">"{entity.nickname}"</p>}
        {entity.author && <p class="profile-author">Submission by {entity.author}</p>}
      </div>

      <div class="profile">
        <div class="profile-media">
          {profileIsGif || profileIsPlaceholder ? (
            <img src={profileNativeSrc} class="pixelart-profile" alt={`Profile image of ${entity.title}`} loading="eager" fetchpriority="high" decoding="async" />
          ) : (
            <Image src={profileImport} class="pixelart-profile" quality={100} alt={`Profile image of ${entity.title}`} loading="eager" fetchpriority="high" decoding="async" />
          )}
          <span class="profile-id">ID {slug}</span>
        </div>

        <div class="stat-grid">
          <div class="stat-cell">
            <span class="info-icon" aria-hidden="true"><StatIcon name="containment" /> </span>Containment Class
            <span class="stat-value">
              {containmentClassHref ? <a href={containmentClassHref}>{entity.containmentClass}</a> : entity.containmentClass}
            </span>
          </div>
          <div class="stat-cell">
            <span class="info-icon" aria-hidden="true"><StatIcon name="type" /> </span>Type
            <span class="stat-value"><HoverText value={entity.type} /></span>
          </div>
          <div class="stat-cell">
            <span class="info-icon" aria-hidden="true"><StatIcon name="species" /> </span>Species
            <span class="stat-value"><HoverText value={entity.species} /></span>
          </div>
          <div class="stat-cell">
            <span class="info-icon" aria-hidden="true"><StatIcon name="gender" /> </span>Gender
            <span class="stat-value"><HoverText value={entity.gender} /></span>
          </div>
          <div class="stat-cell">
            <span class="info-icon" aria-hidden="true"><StatIcon name="age" /> </span>Age
            <span class="stat-value"><HoverText value={String(entity.age)} /></span>
          </div>
          <div class="stat-cell">
            <span class="info-icon" aria-hidden="true"><StatIcon name="foundOn" /> </span>Found On
            <span class="stat-value"><HoverText value={entity.foundOn} /></span>
          </div>
          <div class="stat-cell span-2">
            <span class="info-icon" aria-hidden="true"><StatIcon name="trophic" /> </span>Trophic Role
            <span class="stat-value"><HoverText value={entity.vorePreference?.length ? entity.vorePreference.join(', ') : 'None'} /></span>
          </div>
        </div>
      </div>
    </section>

    <section class="card" role="region" aria-labelledby="bio-title">
      <h2 id="bio-title" class="db-title-cyan">Bio</h2>
      <div class="article-body">
        <Content />
      </div>
    </section>

    <section class="traits-grid" aria-label="Traits">
      <div class="card" role="region" aria-labelledby="pos-title">
        <h2 id="pos-title" class="db-title-green">Useful Abilities</h2>
        <ul class="trait-list positive">
          {entity.usefulAbilities.length ? entity.usefulAbilities.map((trait) => (
            <li><HoverText value={trait} /></li>
          )) : <li>None</li>}
        </ul>
      </div>
      <div class="card" role="region" aria-labelledby="neg-title">
        <h2 id="neg-title" class="db-title-red">Noteable Events</h2>
        <ul class="trait-list negative">
          {entity.noteableEvents.length ? entity.noteableEvents.map((trait) => (
            <li><HoverText value={trait} /></li>
          )) : <li>None</li>}
        </ul>
      </div>
    </section>

    <section class="card" role="region" aria-labelledby="gallery-title">
      <h2 id="gallery-title">Gallery</h2>
      <div class="gallery-grid">
        {entity.gallery.length ? entity.gallery.map((item) => {
          const imageSrc = getGalleryImage(slug, item.file) ?? placeholderImage;
          const isGif = /\.gif$/i.test(item.file);
          const isPlaceholder = imageSrc === placeholderImage;
          return (
            <figure>
              {isGif ? (
                <img src={typeof imageSrc === 'string' ? imageSrc : imageSrc.src} class="pixelart" alt={`${entity.galleryAlt} — ${item.caption}`} data-caption={item.caption} loading="lazy" decoding="async" />
              ) : isPlaceholder ? (
                <img src={imageSrc} class="pixelart" alt={`${entity.galleryAlt} — ${item.caption}`} data-caption={item.caption} loading="lazy" decoding="async" />
              ) : (
                <Image src={imageSrc} class="pixelart" alt={`${entity.galleryAlt} — ${item.caption}`} data-caption={item.caption} loading="lazy" />
              )}
              <figcaption><HoverText value={item.caption} /></figcaption>
            </figure>
          );
        }) : <p class="field-hint">No gallery images added yet.</p>}
      </div>
    </section>

    <nav class="article-return" aria-label="Database navigation">
      <a href={`${base}/database`}>← Back to Database</a>
    </nav>
  </div>
</main>

<div id="lightbox" class="lightbox-overlay" role="dialog" aria-modal="true" hidden tabindex="-1">
  <div class="lightbox-content">
    <button id="lightbox-close" class="lightbox-close" aria-label="Close image">×</button>
    <img class="lightbox-img" alt="" />
  </div>
</div>

<Footer />
