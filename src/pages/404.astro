---
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
---

<Header
  title="Data Not Found"
  description="The requested page could not be found."
/>

<main id="main" tabindex="-1">
  <section class="error-screen" aria-labelledby="error-title">
    <div class="error-scanlines" aria-hidden="true"></div>
    <div class="error-content">
      <p class="error-kicker">AXION NETWORK / ROUTE FAILURE</p>
      <div class="error-code" aria-hidden="true">404</div>
      <h1 id="error-title">Data Not Found <span class="cursor" aria-hidden="true"></span></h1>
      <p class="error-message">
        The requested file is outside the current facility database or has been sealed by the system.
      </p>
      <div class="error-status" role="status">
        <span class="error-status-dot" aria-hidden="true"></span>
        <span>Connection online</span>
        <span class="error-status-divider" aria-hidden="true">/</span>
        <span>Data unavailable</span>
      </div>
      <div class="error-actions">
        <a class="btn" href="/">Return to main menu</a>
        <a class="btn secondary" href="/database">Open database</a>
      </div>
    </div>
    <div class="error-corner error-corner-top" aria-hidden="true"></div>
    <div class="error-corner error-corner-bottom" aria-hidden="true"></div>
  </section>
</main>

<Footer />


