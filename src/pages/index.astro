---
import Header from  '../components/header.astro';
import Footer from '../components/footer.astro';
import { getCollection } from 'astro:content';
import { execSync } from 'node:child_process';
import { statSync } from 'node:fs';
import path from 'node:path';

// Prefer real git history for "last updated"; fall back to filesystem mtime if git is unavailable.
function lastUpdated(absPath: string): Date {
  try {
    const iso = execSync(`git log -1 --format=%cI -- "${absPath}"`, { cwd: process.cwd() }).toString().trim();
    if (iso) return new Date(iso);
  } catch {}
  try {
    return statSync(absPath).mtime;
  } catch {
    return new Date(0);
  }
}

const contentDir = path.join(process.cwd(), 'src', 'content');
const pagesDir = path.join(process.cwd(), 'src', 'pages');

const pageHref = (id: string) => {
  const pageId = id.replace(/\.md$/, '');
  const levelMatch = pageId.match(/^level-(\d+)$/);
  if (levelMatch) return `/Levels/${levelMatch[1]}`;

  const classMatch = pageId.match(/^class-([a-z])$/);
  if (classMatch) return `/Classes/${classMatch[1]}`;

  return `/${pageId}`;
};

const [articles, personnel, entities, synthetics, pages] = await Promise.all([
  getCollection('articles', ({ data }) => !data.draft),
  getCollection('personnel', ({ data }) => !data.draft),
  getCollection('entities', ({ data }) => !data.draft),
  getCollection('synthetics', ({ data }) => !data.draft),
  getCollection('pages'),
]);

const updates = [
  ...articles.map((entry) => ({
    title: entry.data.title,
    href: `/Articles/${entry.slug}`,
    verb: 'Log filed',
    date: lastUpdated(path.join(contentDir, 'articles', entry.id)),
  })),
  ...personnel.map((entry) => ({
    title: entry.data.title,
    href: `/Personnel/${entry.id.replace(/\.md$/, '')}`,
    verb: 'Personnel record updated',
    date: lastUpdated(path.join(contentDir, 'personnel', entry.id)),
  })),
  ...entities.map((entry) => ({
    title: entry.data.title,
    href: `/Entities/${entry.id.replace(/\.md$/, '')}`,
    verb: 'Entity file updated',
    date: lastUpdated(path.join(contentDir, 'entities', entry.id)),
  })),
  ...synthetics.map((entry) => ({
    title: entry.data.title,
    href: `/Synthetics/${entry.id.replace(/\.md$/, '')}`,
    verb: 'Synthetic record updated',
    date: lastUpdated(path.join(contentDir, 'synthetics', entry.id)),
  })),
  ...pages.map((entry) => ({
    title: entry.data.title,
    href: pageHref(entry.id),
    verb: 'Page updated',
    date: lastUpdated(path.join(contentDir, 'pages', entry.id)),
  })),
  {
    title: 'Contact',
    href: '/contact',
    verb: 'Page updated',
    date: lastUpdated(path.join(pagesDir, 'contact.astro')),
  },
  {
    title: 'Home',
    href: '/',
    verb: 'Page updated',
    date: lastUpdated(path.join(pagesDir, 'index.astro')),
  },
].sort((a, b) => b.date.getTime() - a.date.getTime());

const recentUpdates = updates.slice(0, 6);
const lastSync = updates.length ? updates[0].date : new Date();

const formatDate = (date: Date) => date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'short', day: 'numeric',
});
const formatDateTime = (date: Date) => `${formatDate(date)} — ${date.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: false })}`;

const archiveIndex = [
  { label: 'Entities', unit: 'files', count: entities.length, tint: 'var(--neon-blue)', tab: 'entities' },
  { label: 'Personnel', unit: 'records', count: personnel.length, tint: 'var(--neon-yellow)', tab: 'personnel' },
  { label: 'Synthetics', unit: 'units', count: synthetics.length, tint: 'var(--neon-cyan)', tab: 'synthetics' },
  { label: 'Reports', unit: 'logs', count: articles.length, tint: 'var(--neon-green)', tab: 'articles' },
];

const facilityLevels = [
  { level: 0, name: 'Reception', tint: 'var(--text)' },
  { level: 1, name: 'Offices', tint: 'var(--neon-blue)' },
  { level: 2, name: 'Light Containment', tint: 'var(--neon-cyan)' },
  { level: 3, name: 'Heavy Containment', tint: 'var(--neon-green)' },
  { level: 4, name: 'Research', tint: 'var(--neon-orange)' },
  { level: 5, name: 'Private', tint: 'var(--neon-red)', restricted: true },
];
const levelsOnline = facilityLevels.filter((level) => !level.restricted).length;
const archiveTotal = archiveIndex.reduce((sum, item) => sum + item.count, 0);
const latestUpdate = recentUpdates[0];

const bulletins = [
  { title: 'Gear 100% OFF!!', body: 'For all Axion employees, register for a new cybernetic magi-tech implant now!' },
  { title: 'Bio-Care Appointment', body: 'Got hurt on the job? Make an appointment at our Bio-Care center!' },
  { title: 'No recent accidents!', body: 'Thanks to our great safety precautions, there has been no accident in 4 days!' },
  { title: 'New Creatures!', body: 'Visit our new S ranked captured creatures at the level 2 observatory!' },
];
---

<Header></Header>
 
  <main id="main" tabindex="-1">
    <section class="hero" role="region" aria-label="Main">
      <div>
        <div class="card welcome-card" role="article" aria-labelledby="welcome-title">
          <div class="welcome-top">
            <div class="welcome-intro">
              <div class="panel-kicker">
                <span class="kicker-keep-case">A1oS · ver 1.0</span>
              </div>
              <h1 id="welcome-title">Welcome <span class="cursor" aria-hidden="true"></span></h1>
              <p class="lead">Axion Labs main database.</p>

              <nav class="command-grid" aria-label="Quick access">
                <a class="command-tile primary" href="/database" style="--tile-tint:var(--neon-cyan)">
                  <span class="command-key">CMD.01 / Archive</span>
                  <span class="command-label">Access Database</span>
                  <span class="command-arrow" aria-hidden="true">&gt;</span>
                </a>
                <a class="command-tile" href="/facility" style="--tile-tint:var(--neon-blue)">
                  <span class="command-key">CMD.02 / Schematics</span>
                  <span class="command-label">Facility Overview</span>
                  <span class="command-arrow" aria-hidden="true">&gt;</span>
                </a>
              </nav>
            </div>

            <nav class="archive-index" aria-labelledby="archive-index-title">
              <div class="panel-kicker">
                <span id="archive-index-title">Archive Index</span>
                <span class="panel-kicker-meta">{archiveTotal} records</span>
              </div>
              <div class="archive-grid">
                {archiveIndex.map((item) => (
                  <a class="archive-tile" href={`/database?tab=${item.tab}`} style={`--tile-tint:${item.tint}`}>
                    <span class="archive-count">{String(item.count).padStart(3, '0')}</span>
                    <span class="archive-label">{item.label} <span class="archive-unit">{item.unit}</span></span>
                  </a>
                ))}
              </div>
            </nav>
          </div>

          <nav class="level-strip" aria-labelledby="level-strip-title">
            <div class="panel-kicker">
              <span id="level-strip-title">Level Connection Status</span>
              <span class="panel-kicker-meta">{levelsOnline}/{facilityLevels.length} accessible</span>
            </div>
            <ol class="level-grid">
              {facilityLevels.map((item) => (
                <li>
                  <a
                    class:list={['level-chip', { restricted: item.restricted }]}
                    href={`/Levels/${item.level}`}
                    style={`--tile-tint:${item.tint}`}
                    aria-label={item.restricted ? `Level ${item.level}, restricted` : undefined}
                  >
                    <span class="level-num">Level {item.level}</span>
                    <span class="level-name">{item.name}</span>
                    <span class="level-state"><span class="status-dot" aria-hidden="true"></span>{item.restricted ? 'Unauthorized' : 'Online'}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>

          <div class="console-log" data-terminal>
            <ol class="console-lines" aria-label="Terminal output" aria-live="polite" data-terminal-output>
              <li><span class="console-prompt">&gt;</span> A1oS boot sequence <span class="console-ok">OK</span></li>
              <li><span class="console-prompt">&gt;</span> Archive mounted: {archiveTotal} records indexed</li>
              <li><span class="console-prompt">&gt;</span> Containment sweep: {entities.length} entities accounted for</li>
              {latestUpdate && (
                <li><span class="console-prompt">&gt;</span> Last write: {latestUpdate.verb.toLowerCase()} [{latestUpdate.title}]</li>
              )}
              <li><span class="console-prompt">&gt;</span> Server connection <span class="console-ok">OK</span></li>
            </ol>
            <label class="console-input-line">
              <span class="console-prompt" aria-hidden="true">&gt;</span>
              <span class="console-input-field">
                <input
                  class="console-input"
                  type="text"
                  placeholder="Awaiting input"
                  aria-label="Terminal command (type help for a list of commands)"
                  autocomplete="off"
                  autocapitalize="off"
                  autocorrect="off"
                  spellcheck="false"
                  enterkeyhint="send"
                  data-terminal-input
                />
                <span class="console-input-mirror" aria-hidden="true" data-terminal-mirror>Awaiting input<span class="console-caret"></span></span>
              </span>
            </label>
          </div>

          <div class="bulletin" role="complementary" aria-label="Facility bulletin">
            <div class="bulletin-track">
              {bulletins.map((item) => (
                <span class="bulletin-item"><strong>{item.title}</strong>{item.body}</span>
              ))}
              {bulletins.map((item) => (
                <span class="bulletin-item" aria-hidden="true"><strong>{item.title}</strong>{item.body}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
      <aside>
        <div class="card status-card" style="text-align:left">
          <h2 style="margin-top:0">System Status</h2>

          <div class="status-row">
            <span class="status-label">Current Time:</span>
            <span id="facility-clock" class="status-clock">Initializing</span>
          </div>

          <div class="status-row">
            <span class="status-label">Last Data Sync</span>
            <span class="status-value" data-local-datetime={lastSync.toISOString()}>{formatDateTime(lastSync)}</span>
          </div>

          <div class="status-updates">
            <div class="status-label">Recent Log Updates</div>
            <ul>
              {recentUpdates.map((update) => (
                <li>
                  <a href={update.href}>{update.verb}: {update.title}</a>
                  <time datetime={update.date.toISOString()} data-local-date={update.date.toISOString()}>{formatDate(update.date)}</time>
                </li>
              ))}
            </ul>
          </div>

          <div class="status-row status-footer">
            <span class="status-label">Containment</span>
            <span class="status-ok"><span class="status-dot" aria-hidden="true"></span>All Good</span>
          </div>
        </div>
      </aside>
    </section>

   
  </main>


  <Footer></Footer>

<script>
  import { initTerminal } from '../lib/terminal';

  function formatLocalDate(date: Date) {
    return new Intl.DateTimeFormat('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    }).format(date);
  }

  function formatLocalDateTime(date: Date) {
    return `${formatLocalDate(date)} — ${new Intl.DateTimeFormat('en-US', {
      hour: 'numeric',
      minute: '2-digit',
      hour12: false,
    }).format(date)}`;
  }

  function localizeTimestamps() {
    document.querySelectorAll<HTMLElement>('[data-local-datetime]').forEach((element) => {
      const value = element.dataset.localDatetime;
      if (value) element.textContent = formatLocalDateTime(new Date(value));
    });

    document.querySelectorAll<HTMLTimeElement>('[data-local-date]').forEach((element) => {
      const value = element.dataset.localDate;
      if (value) element.textContent = formatLocalDate(new Date(value));
    });
  }

  // Module scripts don't re-run after a view-transition swap, so (re)start the
  // clock on every page load and clear the previous interval to avoid duplicates.
  let clockInterval: ReturnType<typeof setInterval> | undefined;
  function stopClock() {
    clearInterval(clockInterval);
    clockInterval = undefined;
  }

  function tick() {
    const clockEl = document.getElementById('facility-clock');
    if (!clockEl) {
      stopClock();
      return;
    }
    clockEl.textContent = new Date().toLocaleTimeString('en-US', { hour12: false });
  }

  function initializeStatusPanel() {
    document.querySelectorAll<HTMLElement>('[data-terminal]').forEach(initTerminal);
    localizeTimestamps();
    tick();
    stopClock();
    if (!document.getElementById('facility-clock')) return;
    clockInterval = setInterval(tick, 1000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeStatusPanel, { once: true });
  } else {
    initializeStatusPanel();
  }
  document.addEventListener('astro:page-load', initializeStatusPanel);
</script>

