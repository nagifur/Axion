---
import Header from  '../components/header.astro';
import Footer from '../components/footer.astro';
import { getCollection } from 'astro:content';
import { execSync } from 'node:child_process';
import { statSync } from 'node:fs';
import path from 'node:path';

// Prefer real git history for "last updated"; fall back to filesystem mtime if git is unavailable.
function lastUpdated(absPath: string): Date {
  try {
    const iso = execSync(`git log -1 --format=%cI -- "${absPath}"`, { cwd: process.cwd() }).toString().trim();
    if (iso) return new Date(iso);
  } catch {}
  try {
    return statSync(absPath).mtime;
  } catch {
    return new Date(0);
  }
}

const contentDir = path.join(process.cwd(), 'src', 'content');
const pagesDir = path.join(process.cwd(), 'src', 'pages');

const pageHref = (id: string) => {
  const pageId = id.replace(/\.md$/, '');
  const levelMatch = pageId.match(/^level-(\d+)$/);
  if (levelMatch) return `/Levels/${levelMatch[1]}`;

  const classMatch = pageId.match(/^class-([a-z])$/);
  if (classMatch) return `/Classes/${classMatch[1]}`;

  return `/${pageId}`;
};

const [articles, personnel, entities, pages] = await Promise.all([
  getCollection('articles', ({ data }) => !data.draft),
  getCollection('personnel', ({ data }) => !data.draft),
  getCollection('entities', ({ data }) => !data.draft),
  getCollection('pages'),
]);

const updates = [
  ...articles.map((entry) => ({
    title: entry.data.title,
    href: `/Articles/${entry.slug}`,
    verb: 'Log filed',
    date: lastUpdated(path.join(contentDir, 'articles', entry.id)),
  })),
  ...personnel.map((entry) => ({
    title: entry.data.title,
    href: `/Personnel/${entry.id.replace(/\.md$/, '')}`,
    verb: 'Personnel record updated',
    date: lastUpdated(path.join(contentDir, 'personnel', entry.id)),
  })),
  ...entities.map((entry) => ({
    title: entry.data.title,
    href: `/Entities/${entry.id.replace(/\.md$/, '')}`,
    verb: 'Entity file updated',
    date: lastUpdated(path.join(contentDir, 'entities', entry.id)),
  })),
  ...pages.map((entry) => ({
    title: entry.data.title,
    href: pageHref(entry.id),
    verb: 'Page updated',
    date: lastUpdated(path.join(contentDir, 'pages', entry.id)),
  })),
  {
    title: 'Contact',
    href: '/contact',
    verb: 'Page updated',
    date: lastUpdated(path.join(pagesDir, 'contact.astro')),
  },
  {
    title: 'Home',
    href: '/',
    verb: 'Page updated',
    date: lastUpdated(path.join(pagesDir, 'index.astro')),
  },
].sort((a, b) => b.date.getTime() - a.date.getTime());

const recentUpdates = updates.slice(0, 5);
const lastSync = updates.length ? updates[0].date : new Date();

const formatDate = (date: Date) => date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'short', day: 'numeric',
});
const formatDateTime = (date: Date) => `${formatDate(date)} — ${date.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: false })}`;

const bulletins = [
  { title: 'Gear 100% OFF!!', body: 'For all Axion employees, register for a new cybernetic magi-tech implant now!' },
  { title: 'Bio-Care Appointment', body: 'Got hurt on the job? Make an appointment at our Bio-Care center!' },
  { title: 'No recent accidents!', body: 'Thanks to our great safety precautions, there has been no accident in 4 days!' },
  { title: 'New Creatures!', body: 'Visit our new S ranked captured creatures at the level 2 observatory!' },
];
---

<Header></Header>
 
  <main id="main" tabindex="-1">
    <section class="hero" role="region" aria-label="Main">
      <div>
        <div class="card" role="article" aria-labelledby="welcome-title">
          <h1 id="welcome-title">Welcome <span class="cursor" aria-hidden="true"></span></h1>
          <p class="lead">Axion Labs main facility database.</p>
          <p class="lead"> A1oS - ver 1.0</p>

          <div class="cta" aria-hidden="false">
            <a class="btn" href="/database">Access Database</a>
            <a class="btn secondary" href="/about">Facility Overview</a>
          </div>

          <div class="bulletin" role="complementary" aria-label="Facility bulletin">
            <div class="bulletin-track">
              {bulletins.map((item) => (
                <span class="bulletin-item"><strong>{item.title}</strong>{item.body}</span>
              ))}
              {bulletins.map((item) => (
                <span class="bulletin-item" aria-hidden="true"><strong>{item.title}</strong>{item.body}</span>
              ))}
            </div>
          </div>
        </div>

        <section class="card bsky-section" role="region" aria-labelledby="bsky-title">
          <h2 id="bsky-title" class="db-title-cyan">
            <span class="bsky-live" aria-hidden="true"></span>
            Latest Bluesky Posts
          </h2>
          <div id="bsky-feed" class="bsky-feed" aria-live="polite">
            <p class="field-hint">Loading posts…</p>
          </div>
          <p class="field-hint">
            <a href="https://bsky.app/profile/nagifur.bsky.social" target="_blank" rel="noopener noreferrer">View more on Bluesky</a>
          </p>
        </section>
      </div>
      <aside>
        <div class="card" style="text-align:left">
          <h2 style="margin-top:0">System Status</h2>

          <div class="status-row">
            <span class="status-label">Current Time:</span>
            <span id="facility-clock" class="status-clock">--:--:--</span>
          </div>

          <div class="status-row">
            <span class="status-label">Last Data Sync</span>
            <span class="status-value" data-local-datetime={lastSync.toISOString()}>{formatDateTime(lastSync)}</span>
          </div>

          <div class="status-updates">
            <div class="status-label">Recent Log Updates</div>
            <ul>
              {recentUpdates.map((update) => (
                <li>
                  <a href={update.href}>{update.verb}: {update.title}</a>
                  <time datetime={update.date.toISOString()} data-local-date={update.date.toISOString()}>{formatDate(update.date)}</time>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </aside>
    </section>

  </main>

  <div id="bsky-modal" class="bsky-modal" hidden>
    <div class="bsky-modal-backdrop" data-role="close"></div>
    <div class="bsky-modal-panel" role="dialog" aria-modal="true" aria-label="Bluesky post">
      <button type="button" class="bsky-modal-close" data-role="close" aria-label="Close">✕</button>
      <div id="bsky-modal-content"></div>
    </div>
  </div>

  <Footer></Footer>

<script>
  function formatLocalDate(date: Date) {
    return new Intl.DateTimeFormat('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    }).format(date);
  }

  function formatLocalDateTime(date: Date) {
    return `${formatLocalDate(date)} — ${new Intl.DateTimeFormat('en-US', {
      hour: 'numeric',
      minute: '2-digit',
      hour12: false,
    }).format(date)}`;
  }

  function localizeTimestamps() {
    document.querySelectorAll<HTMLElement>('[data-local-datetime]').forEach((element) => {
      const value = element.dataset.localDatetime;
      if (value) element.textContent = formatLocalDateTime(new Date(value));
    });

    document.querySelectorAll<HTMLTimeElement>('[data-local-date]').forEach((element) => {
      const value = element.dataset.localDate;
      if (value) element.textContent = formatLocalDate(new Date(value));
    });
  }

  // Module scripts don't re-run after a view-transition swap, so (re)start the
  // clock on every page load and clear the previous interval to avoid duplicates.
  let clockInterval: ReturnType<typeof setInterval> | undefined;
  function tick() {
    const clockEl = document.getElementById('facility-clock');
    if (!clockEl) return;
    clockEl.textContent = new Date().toLocaleTimeString('en-US', { hour12: false });
  }
  document.addEventListener('astro:page-load', () => {
    localizeTimestamps();
    tick();
    clearInterval(clockInterval);
    clockInterval = setInterval(tick, 1000);
  });

  const BSKY_ACTOR = 'nagifur.bsky.social';
  const BSKY_FEED_ENDPOINT = `https://public.api.bsky.app/xrpc/app.bsky.feed.getAuthorFeed?actor=${BSKY_ACTOR}&limit=6&filter=posts_no_replies`;

  const escapeHtml = (value: string) => value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');

  // Convert an at:// post URI into a bsky.app permalink using the author's handle.
  const postUrl = (uri: string) => {
    const rkey = uri.split('/').pop();
    return `https://bsky.app/profile/${BSKY_ACTOR}/post/${rkey}`;
  };

  const relativeTime = (iso: string) => {
    const diffMs = Date.now() - new Date(iso).getTime();
    const minutes = Math.round(diffMs / 60000);
    if (minutes < 1) return 'just now';
    if (minutes < 60) return `${minutes}m ago`;
    const hours = Math.round(minutes / 60);
    if (hours < 24) return `${hours}h ago`;
    const days = Math.round(hours / 24);
    if (days < 30) return `${days}d ago`;
    return new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
  };

  // Self-applied or labeler-applied adult-content tags; anything else (e.g. spam) is left unblurred.
  const ADULT_LABELS = new Set(['porn',  'nudity']);
  const adultLabel = (post: any): string | undefined => {
    const labels = Array.isArray(post?.labels) ? post.labels : [];
    const match = labels.find((label: any) => ADULT_LABELS.has(label?.val));
    return match?.val;
  };

  // Shared markup for a post, used both in the horizontal feed strip and the enlarged focus modal.
  function renderPost(item: any, index: number, full: boolean): string {
    const post = item.post;
    const record = post?.record ?? {};
    const author = post?.author ?? {};
    const text = escapeHtml(String(record.text ?? '')).replace(/\n/g, '<br />');
    const embed = post?.embed ?? {};
    const media = embed?.media ?? embed;
    const images = media?.images ?? [];
    // Bluesky videos are HLS (.m3u8) streams; hydrated below via hls.js so they can play inline.
    const video = media?.$type === 'app.bsky.embed.video#view' ? media : undefined;
    const isRepost = Boolean(item.reason && item.reason.$type?.includes('reasonRepost'));

    const imagesHtml = images.length
      ? `<div class="bsky-images">${images.map((img: any) => `<img src="${full ? (img.fullsize ?? img.thumb) : img.thumb}" alt="${escapeHtml(img.alt || '')}" loading="lazy" />`).join('')}</div>`
      : '';

    const videoHtml = video
      ? `<video class="bsky-video" poster="${video.thumbnail}" controls playsinline preload="none" data-hls-src="${video.playlist}"></video>`
      : '';

    const label = adultLabel(post);
    const mediaHtml = `${imagesHtml}${videoHtml}`;
    const gatedMediaHtml = mediaHtml && label
      ? `<div class="bsky-cw">
          <button type="button" class="bsky-cw-overlay">
            <span class="bsky-cw-label">⚠ Adult Content</span>
            <span class="bsky-cw-hint">Click to view</span>
          </button>
          <div class="bsky-cw-content">${mediaHtml}</div>
        </div>`
      : mediaHtml;

    return `
      <article class="bsky-post${full ? ' bsky-post--full' : ''}" data-index="${index}">
        <p class="bsky-reason${isRepost ? '' : ' bsky-reason--hidden'}">Reposted</p>
        <div class="bsky-post-head">
          <img class="bsky-avatar" src="${author.avatar ?? ''}" alt="" loading="lazy" />
          <div>
            <span class="bsky-name">${escapeHtml(author.displayName || author.handle || BSKY_ACTOR)}</span>
            <span class="bsky-handle">@${escapeHtml(author.handle || BSKY_ACTOR)}</span>
          </div>
        </div>
        <p class="bsky-text">${text}</p>
        ${gatedMediaHtml}
        <a class="bsky-timestamp" href="${postUrl(post.uri)}" target="_blank" rel="noopener noreferrer">${relativeTime(record.createdAt)}</a>
      </article>
    `;
  }

  function wireUpPost(container: HTMLElement) {
    container.querySelectorAll<HTMLButtonElement>('.bsky-cw-overlay').forEach((button) => {
      button.addEventListener('click', (event) => {
        event.stopPropagation();
        button.closest('.bsky-cw')?.classList.add('revealed');
      });
    });
  }

  let bskyItems: any[] = [];

  function openBskyModal(index: number) {
    const item = bskyItems[index];
    const modal = document.getElementById('bsky-modal');
    const content = document.getElementById('bsky-modal-content');
    if (!item || !modal || !content) return;

    content.innerHTML = renderPost(item, index, true);
    wireUpPost(content);
    hydrateHlsVideos(content);

    modal.hidden = false;
    document.body.classList.add('bsky-modal-open');
  }

  function closeBskyModal() {
    const modal = document.getElementById('bsky-modal');
    if (!modal) return;
    modal.hidden = true;
    document.body.classList.remove('bsky-modal-open');
    const content = document.getElementById('bsky-modal-content');
    if (content) content.innerHTML = '';
  }

  async function loadBskyFeed() {
    const feedEl = document.getElementById('bsky-feed');
    if (!feedEl) return;

    try {
      const response = await fetch(BSKY_FEED_ENDPOINT);
      if (!response.ok) throw new Error(`Bluesky API responded with ${response.status}`);
      const data = await response.json();
      const items = Array.isArray(data.feed) ? data.feed.slice(0, 5) : [];
      bskyItems = items;

      if (!items.length) {
        feedEl.innerHTML = '<p class="field-hint">No recent posts found.</p>';
        return;
      }

      feedEl.innerHTML = items.map((item: any, index: number) => renderPost(item, index, false)).join('');

      wireUpPost(feedEl);

      // Clicking a post (but not its links/buttons/video controls) opens the enlarged focus view.
      feedEl.querySelectorAll<HTMLElement>('.bsky-post').forEach((article) => {
        article.addEventListener('click', (event) => {
          if ((event.target as HTMLElement).closest('a, button, video')) return;
          const index = Number(article.dataset.index);
          if (!Number.isNaN(index)) openBskyModal(index);
        });
      });

      await hydrateHlsVideos(feedEl);
    } catch (error) {
      feedEl.innerHTML = '<p class="field-hint">Couldn\'t load Bluesky posts right now.</p>';
      console.error('Failed to load Bluesky feed', error);
    }
  }

  // Most browsers can't play .m3u8 natively, so load hls.js from a CDN on demand and attach it to each video.
  async function hydrateHlsVideos(container: HTMLElement) {
    const videos = Array.from(container.querySelectorAll<HTMLVideoElement>('video[data-hls-src]'));
    if (!videos.length) return;

    const supportsNativeHls = videos[0].canPlayType('application/vnd.apple.mpegurl') !== '';
    let HlsCtor: any = null;
    if (!supportsNativeHls) {
      try {
        ({ default: HlsCtor } = await import(/* @vite-ignore */ 'https://esm.sh/hls.js@1.5.17'));
      } catch (error) {
        console.error('Failed to load hls.js', error);
      }
    }

    videos.forEach((video) => {
      const src = video.dataset.hlsSrc;
      if (!src) return;
      if (supportsNativeHls) {
        video.src = src;
      } else if (HlsCtor?.isSupported()) {
        const hls = new HlsCtor();
        hls.loadSource(src);
        hls.attachMedia(video);
      }
    });
  }

  document.addEventListener('astro:page-load', loadBskyFeed);

  document.addEventListener('astro:page-load', () => {
    const modal = document.getElementById('bsky-modal');
    if (!modal) return;

    modal.querySelectorAll<HTMLElement>('[data-role="close"]').forEach((el) => {
      el.addEventListener('click', closeBskyModal);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.hidden) closeBskyModal();
    });
  });
</script>

