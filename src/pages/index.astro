 ---
 import Header from  '../components/header.astro';
 import Footer from '../components/footer.astro';
 ---

<Header></Header>

 <body>
 

  <main>
    <section class="hero" role="region" aria-label="Main">
      <div>
        <div class="card" role="article" aria-labelledby="welcome-title">
          <h1 id="welcome-title">Axion Labs <span class="cursor" aria-hidden="true"></span></h1>
          <p class="lead">Welcome to Axion Labs main facility database.</p>
          <p class="lead"> A1oS - ver 1.0</p>

          <div class="cta" aria-hidden="false">
            <a class="btn" href="#about">Get Started</a>
            <a class="btn secondary" href="#features">See Features</a>
          </div>

          <div id="features" class="features" style="margin-top:18px" aria-live="polite">
            <div class="feature"><strong>Neo-Scifi</strong><div style="color:var(--muted)">Neon palette, starfield, scanlines.</div></div>
            <div class="feature"><strong>Responsive</strong><div style="color:var(--muted)">Stacks cleanly on small screens.</div></div>
            <div class="feature"><strong>Lightweight</strong><div style="color:var(--muted)">Pure CSS — no webfonts required.</div></div>
            <div class="feature"><strong>Retro Tools</strong><div style="color:var(--muted)">Customize colours, add pixel art, or link to your server.</div></div>
          </div>
        </div>
      </div>
<!-- Main links -->
      <aside>
        <div class="card" style="text-align:left">
          <h2 style="margin-top:0">Quick Links</h2>
          <ul style="padding-left:18px; color:var(--muted); margin:10px 0">
            <li><a href="#" style="color:var(--neon-cyan)">Documentation</a></li>
            <li><a href="#" style="color:var(--neon-cyan)">Examples</a></li>
            <li><a href="#contact" style="color:var(--neon-cyan)">Contact</a></li>
          </ul>
          <div style="margin-top:12px; color:var(--muted)">Frequently visited</div>
        </div>
      </aside>
    </section>

   
  </main>


  <Footer></Footer>

