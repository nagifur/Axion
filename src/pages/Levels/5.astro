---
import Header from  '../../components/header.astro';
import Footer from '../../components/footer.astro';
import { getEntry, render } from 'astro:content';

const page = await getEntry('pages', 'level-5');
if (!page) {
  throw new Error('Missing content/pages/level-5.md');
}
const { Content } = await render(page);
---
<Header title={page.data.title} />

<main id="main" tabindex="-1">
  <nav class="article-return-top" aria-label="Database navigation">
    <a href="/database">
      <span class="article-return-arrow" aria-hidden="true">←</span>
      <span>Back</span>
    </a>
  </nav>
  <article class="article-page">
    <header class="card article-header">
      <h1>{page.data.title} <span class="cursor" aria-hidden="true"></span></h1>
    </header>

    {page.data.accessDenied ? (
      <section class="card access-gate" aria-labelledby="access-gate-title">
        <div class="access-gate-status"><span aria-hidden="true"></span>Security protocol active</div>
        <div class="access-gate-lock" aria-hidden="true"><span></span></div>
        <p class="access-gate-kicker">Axion internal network</p>
        <h2 id="access-gate-title">Access denied</h2>
        <dl class="access-gate-details">
          <div><dt>Requested node</dt><dd>{page.data.title}</dd></div>
          <div><dt>Required clearance</dt><dd>Level {page.data.requiredClearance}</dd></div>
          <div><dt>Current clearance</dt><dd>Level {page.data.viewerClearance}</dd></div>
        </dl>
        <p class="access-gate-notice">{page.data.denialNotice}</p>
      </section>
    ) : (
      <section class="card article-body">
        <Content />
      </section>
    )}

    <nav class="article-return" aria-label="Database navigation">
      <a href="/database">← Back to Database</a>
    </nav>
  </article>
</main>


<Footer></Footer>
