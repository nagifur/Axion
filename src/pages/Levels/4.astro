---
import Header from  '../../components/header.astro';
import Footer from '../../components/footer.astro';
import { getEntry, render } from 'astro:content';

const page = await getEntry('pages', 'level-4');
if (!page) {
  throw new Error('Missing content/pages/level-4.md');
}
const { Content } = await render(page);
---
<Header title={page.data.title} />

<main id="main" tabindex="-1">
  <nav class="article-return-top" aria-label="Database navigation">
    <a href="/database">
      <span class="article-return-arrow" aria-hidden="true">←</span>
      <span>Back</span>
    </a>
  </nav>
  <article class="article-page">
    <header class="card article-header">
      <h1>{page.data.title} <span class="cursor" aria-hidden="true"></span></h1>
    </header>

    <section class="card article-body">
      <Content />
    </section>

    <nav class="article-return" aria-label="Database navigation">
      <a href="/database">← Back to Database</a>
    </nav>
  </article>
</main>


<Footer></Footer>
