---
interface Props {
  name: 'access' | 'position' | 'species' | 'gender' | 'height' | 'age' | 'origin' | 'trophic'
      | 'type' | 'foundOn' | 'containment';
}
const { name } = Astro.props;
---

{name === 'access' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <circle cx="8" cy="8" r="4" />
    <path d="M11 11 L20 20 M15 16 L18 13 M17 18 L19.5 15.5" />
  </svg>
)}
{name === 'position' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <rect x="3" y="7" width="18" height="13" rx="1" />
    <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2 M3 12h18" />
  </svg>
)}
{name === 'species' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M6 4c4 3 4 5 0 8 M18 4c-4 3-4 5 0 8 M6 12c4 3 4 5 0 8 M18 12c-4 3-4 5 0 8" />
    <path d="M6.5 6h11 M6.5 10h11 M6.5 14h11 M6.5 18h11" stroke-width="1" />
  </svg>
)}
{name === 'gender' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <circle cx="9" cy="14" r="5" />
    <path d="M13 10 L20 3 M15 3h5v5" />
  </svg>
)}
{name === 'height' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <rect x="5" y="2" width="6" height="20" rx="1" />
    <path d="M5 6h3 M5 10h3 M5 14h3 M5 18h3" stroke-width="1" />
  </svg>
)}
{name === 'age' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <circle cx="12" cy="12" r="9" />
    <path d="M12 7v5l3 3" />
  </svg>
)}
{name === 'origin' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <circle cx="12" cy="12" r="9" />
    <path d="M3 12h18 M12 3c3 3 3 15 0 18 M12 3c-3 3-3 15 0 18" />
  </svg>
)}
{name === 'trophic' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M6 3v7a2 2 0 0 0 4 0V3 M8 10v11 M17 3c-2 0-3 2-3 4v3h3 M17 3v18" />
  </svg>
)}
{name === 'type' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M12 2 3 7l9 5 9-5-9-5Z" />
    <path d="M3 12l9 5 9-5 M3 17l9 5 9-5" />
  </svg>
)}
{name === 'foundOn' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M12 22s7-6.5 7-12a7 7 0 0 0-14 0c0 5.5 7 12 7 12Z" />
    <circle cx="12" cy="10" r="2.5" />
  </svg>
)}
{name === 'containment' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <rect x="5" y="10" width="14" height="11" rx="1" />
    <path d="M8 10V7a4 4 0 0 1 8 0v3" />
    <circle cx="12" cy="15" r="1.5" />
  </svg>
)}