---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rootUrl = (path: string) => `${base}/${path}`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <!--Force load logo svg-->
  <link rel="preload" href={rootUrl('Logo.svg')} as="image" type="image/svg+xml" />
  <link rel="preload" href={rootUrl('Logo-light.svg')} as="image" type="image/svg+xml" />
  <link rel="stylesheet" href={rootUrl('style.css')}/>
  <link rel="icon" type="image/svg+xml" href={rootUrl('favicon.svg')} />
  <script src={rootUrl('script.js')} defer></script>
  <title>Axion Labs</title>
  <meta name="description" content="Welcome to Axion Labs" />
</head>

<body>

<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header">
  <a class="brand" href={base || '/'} aria-label="Axion Labs home">
    <div class="logo">
      <img class="logo-dark" src={rootUrl('Logo.svg')} width="89" height="60" fetchpriority="high" decoding="sync" alt="" aria-hidden="true" />
      <img class="logo-light" src={rootUrl('Logo-light.svg')} width="89" height="60" fetchpriority="high" decoding="sync" alt="" aria-hidden="true" />
    </div>
    <div class="brand-copy">
      <div class="brand-title">Axion Labs</div>
      <div class="brand-meta">Logged in: User#6382</div>
      <div class="brand-meta">Access Level: 4</div>
    </div>
  </a>

  <div class="header-tools">
    <button id="nav-toggle" class="nav-toggle" aria-expanded="false" aria-controls="site-nav" title="Toggle menu">
      <span></span><span></span><span></span>
    </button>
    <nav id="site-nav" class="site-nav">
      <a href={rootUrl('about')}>About</a>
      <a href={rootUrl('contact')}>Contact</a>
      <button id="animations-toggle" class="theme-toggle" aria-pressed="true" title="Toggle animations" aria-label="Toggle animations">Animations On</button>
    <button id="theme-toggle" class="theme-toggle" aria-pressed="false" title="Toggle theme">Light Mode</button>
    </nav>
    
  </div>
</header>

<noscript>
  <style>#site-nav{ max-height:none !important; }</style>
</noscript>

<script>
  const navToggle = document.getElementById('nav-toggle');
  const siteNav = document.getElementById('site-nav');
  navToggle?.addEventListener('click', () => {
    const isOpen = siteNav?.classList.toggle('nav-open');
    navToggle.setAttribute('aria-expanded', String(!!isOpen));
  });
</script>
