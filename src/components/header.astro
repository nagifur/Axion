---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: 'website' | 'article' | 'profile';
}

const {
  title = 'Axion Labs',
  description = 'Axion Labs main facility database — a fictional sci-fi universe of characters, creatures, and lore.',
  image = '/og-image.png',
  imageAlt = 'Axion Labs',
  imageWidth = 1200,
  imageHeight = 630,
  type = 'website',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rootUrl = (path: string) => `${base}/${path}`;
const pageTitle = title === 'Axion Labs' ? title : `${title} | Axion Labs`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <!-- Runs before first paint so the correct theme is set and no flash occurs -->
  <script is:inline>
    (function () {
      try {
        var stored = localStorage.getItem('theme');
        var theme = stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (_) {}
    })();
  </script>
  <meta name="color-scheme" content="dark light" />
  <ClientRouter />
  <!--Force load logo svg-->
  <link rel="preload" href={rootUrl('Logo.svg')} as="image" type="image/svg+xml" />
  <link rel="preload" href={rootUrl('Logo-light.svg')} as="image" type="image/svg+xml" />
  <link rel="stylesheet" href={rootUrl('style.css')}/>
  <link rel="icon" type="image/svg+xml" href={rootUrl('favicon.svg')} />
  <script src={rootUrl('script.js')} defer></script>
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="Axion Labs" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:alt" content={imageAlt} />
  <meta property="og:image:width" content={String(imageWidth)} />
  <meta property="og:image:height" content={String(imageHeight)} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />
</head>

<body>

<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header">
  <a class="brand" href={base || '/'} aria-label="Axion Labs home">
    <div class="logo">
      <img class="logo-dark" src={rootUrl('Logo.svg')} width="89" height="60" fetchpriority="high" decoding="sync" alt="" aria-hidden="true" />
      <img class="logo-light" src={rootUrl('Logo-light.svg')} width="89" height="60" fetchpriority="high" decoding="sync" alt="" aria-hidden="true" />
    </div>
    <div class="brand-copy">
      <div class="brand-title">Axion Labs</div>
      <div class="brand-meta">Logged in: User#6382</div>
      <div class="brand-meta">Access Level: 4</div>
    </div>
  </a>

  <div class="header-tools">
    <button id="nav-toggle" class="nav-toggle" aria-expanded="false" aria-controls="header-menu" title="Toggle menu">
      <span></span><span></span><span></span>
    </button>
    <div id="header-menu" class="header-actions">
      <nav id="site-nav" class="site-nav" aria-label="Facility navigation">
        <span class="nav-kicker">Nav</span>
        <a class="nav-link" href={rootUrl('database')}>Database</a>
        <a class="nav-link" href={rootUrl('about')}>About</a>
        <a class="nav-link" href={rootUrl('contact')}>Contact</a>
      </nav>
      <div class="system-controls" aria-label="System controls">
        <span class="system-kicker">System</span>
        <button id="animations-toggle" class="utility-toggle animation-toggle" aria-pressed="true" title="Toggle animations" aria-label="Toggle animations">Animations On</button>
        <button id="theme-toggle" class="utility-toggle theme-toggle" aria-pressed="false" title="Toggle theme">Light Mode</button>
      </div>
    </div>
    
  </div>
</header>

<noscript>
  <style>#header-menu{ max-height:none !important; }</style>
</noscript>

<script>
  // Module scripts don't re-run after a view-transition swap, so rebind on each page load.
  document.addEventListener('astro:page-load', () => {
    const navToggle = document.getElementById('nav-toggle');
    const headerMenu = document.getElementById('header-menu');
    navToggle?.addEventListener('click', () => {
      const isOpen = headerMenu?.classList.toggle('nav-open');
      navToggle.setAttribute('aria-expanded', String(!!isOpen));
    });
  });
</script>
