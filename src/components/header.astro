---
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <!--Force load logo svg-->
  <link rel="preload" href="/Axion/Logo.svg" as="image" type="image/svg+xml" />
  <link rel="preload" href="/Axion/Logo-light.svg" as="image" type="image/svg+xml" />
  <link rel="stylesheet" href="/Axion/style.css"/>
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <script src="/Axion/script.js" defer></script>
  <title>Axion Labs</title>
  <meta name="description" content="Welcome to Axion — simple, fast, and accessible." />
</head>

<body>

<header class="site-header">
  <a class="brand" href="/Axion" aria-label="Axion Labs home">
    <div class="logo">
      <img class="logo-dark" src="/Axion/Logo.svg" width="89" height="60" fetchpriority="high" decoding="sync" alt="" aria-hidden="true" />
      <img class="logo-light" src="/Axion/Logo-light.svg" width="89" height="60" fetchpriority="high" decoding="sync" alt="" aria-hidden="true" />
    </div>
    <div class="brand-copy">
      <div class="brand-title">Axion Labs</div>
      <div class="brand-meta">Logged in: User#5542</div>
      <div class="brand-meta">Access Level: 4</div>
    </div>
  </a>

  <div class="header-tools">
    <button id="nav-toggle" class="nav-toggle" aria-expanded="false" aria-controls="site-nav" title="Toggle menu">
      <span></span><span></span><span></span>
    </button>
    <nav id="site-nav" class="site-nav">
      <a href="/Axion/about">About</a>
      <a href="/Axion/contact">Contact</a>
      <button id="animations-toggle" class="theme-toggle" aria-pressed="true" title="Toggle animations" aria-label="Toggle animations">Animations On</button>
    <button id="theme-toggle" class="theme-toggle" aria-pressed="false" title="Toggle theme">Light Mode</button>
    </nav>
    
  </div>
</header>

<noscript>
  <style>#site-nav{ max-height:none !important; }</style>
</noscript>

<script>
  const navToggle = document.getElementById('nav-toggle');
  const siteNav = document.getElementById('site-nav');
  navToggle?.addEventListener('click', () => {
    const isOpen = siteNav?.classList.toggle('nav-open');
    navToggle.setAttribute('aria-expanded', String(!!isOpen));
  });
</script>
