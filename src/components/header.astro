---
import { Image } from 'astro:assets';
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <!--Force load logo svg-->
  <link rel="preload" href="/Axion/Logo.svg" as="image" type="image/svg+xml" />
  <link rel="stylesheet" href="/Axion/style.css"/>
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <script src="/Axion/script.js" defer></script>
  <title>Axion Labs</title>
  <meta name="description" content="Welcome to Axion — simple, fast, and accessible." />
  
</head>



<header>
    <a class="brand" href="/Axion">
      <div class="logo">
        <img src="/Axion/Logo.svg" width="89" height="60" fetchpriority="high" decoding="sync" alt="Axion Labs Logo" />
      </div>
      <div>
        <div style="font-weight:900; color:var(--neon-yellow)">Axion Labs</div>
        <div style="font-size:0.8rem;color:var(--muted);margin-top:2px">Logged in: <b>User#5542</b></div>
        <div style="font-size:0.8rem;color:var(--muted);margin-top:2px">Access Level: <b>4</b></div>
      </div>
      </div>
    </a>

    <div style="display:flex;align-items:center;gap:10px">
      <div class="win-controls" aria-hidden="true">
        <div class="dot r"></div>
        <div class="dot y"></div>
        <div class="dot g"></div>
      </div>
      <nav>
        <a href="/Axion/about">About</a>
        <a href="#contact">Contact</a>
      </nav>
      <button id="theme-toggle" class="theme-toggle" aria-pressed="false" title="Toggle theme">Light Mode</button>
    </div>
  </header>

   <body>
